diff --git a/sandbox/policy/linux/bpf_cros_nvidia_gpu_policy_linux.cc b/sandbox/policy/linux/bpf_cros_nvidia_gpu_policy_linux.cc
index c4e4614eb8..8b2bf9aadf 100644
--- a/sandbox/policy/linux/bpf_cros_nvidia_gpu_policy_linux.cc
+++ b/sandbox/policy/linux/bpf_cros_nvidia_gpu_policy_linux.cc
@@ -3,6 +3,8 @@
 // found in the LICENSE file.
 
 #include "sandbox/policy/linux/bpf_cros_nvidia_gpu_policy_linux.h"
+#include "sandbox/linux/seccomp-bpf-helpers/syscall_parameters_restrictions.h"
+#include <sys/mman.h>
 
 // Define these so that unistd.h pulls in needed symbols.
 #if !defined(__ARCH_WANT_SYSCALL_NO_AT) || \
@@ -30,6 +32,15 @@ ResultExpr CrosNvidiaGpuProcessPolicy::EvaluateSyscall(int sysno) const {
   switch (sysno) {
     case __NR_sched_setscheduler:
       return Allow();
+    case __NR_mprotect:
+      return RestrictMprotectFlags();
+#if defined(__x86_64__)
+    case __NR_mmap:
+      return RestrictMmapFlags(MAP_EXECUTABLE | MAP_32BIT);
+#endif
+    case __NR_memfd_create:
+      // TODO(crbug.com/442771181)
+      return RestrictMemfdCreateWithExecMappings();
     default:
       return GpuProcessPolicy::EvaluateSyscall(sysno);
   }
