@@ -205,8 +207,19 @@ bool IncognitoModePrefs::ShouldLaunchIncognitoInternal(
         browser_defaults::
             kAlwaysOpenIncognitoBrowserIfStartedWithIncognitoSwitch;
   }
+  const PrefService* pref_service = profile->GetPrefs();
+  bool incognito_launch = pref_service->GetBoolean(prefs::kIncognitoLaunch) &&
+         (pref_service->GetBoolean(prefs::kIncognitoStartup) ||
+         StartupTabProviderImpl().
+             HasCommandLineTabs(command_line, base::FilePath("")) ==
+                 CommandLineTabsPresent::kYes) &&
+         (!for_subsequent_browsers || browser_defaults::
+            kAlwaysOpenIncognitoBrowserIfStartedWithIncognitoSwitch) &&
+         !command_line.HasSwitch(switches::kAppId) &&
+         !command_line.HasSwitch(switches::kApp);
   bool should_use_incognito =
       forced_by_switch ||
+      incognito_launch ||
       GetAvailabilityInternal(profile, DONT_CHECK_PARENTAL_CONTROLS) ==
           IncognitoModeAvailability::kForced;
   return should_use_incognito &&
