+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_GEOMETRY_POLICY_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_GEOMETRY_POLICY_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace helium_noise {
+
+// Native, un-noised geometry inputs in direct DIP/CSS-like units.
+struct GeometryInputs {
+  gfx::Rect screen_dip;
+  gfx::Rect available_dip;
+  gfx::Rect window_dip;
+  gfx::Size viewport_css;
+  double device_pixel_ratio;
+};
+
+// Selected geometry view; all consumers derive their exposed values from one
+// validated result.
+struct GeometryView {
+  gfx::Rect screen_dip;
+  gfx::Rect available_dip;
+  gfx::Rect window_dip;
+  gfx::Size viewport_css;
+  double device_pixel_ratio;
+};
+
+// Selects the one coupled geometry view for the profile hash and native
+// inputs, or fails closed as a whole on any invalid coupled state.
+CORE_EXPORT std::optional<GeometryView> ComputeGeometryView(
+    uint64_t profile_hash,
+    const GeometryInputs& native);
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_GEOMETRY_POLICY_H_
