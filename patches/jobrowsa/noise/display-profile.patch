--- /dev/null
+++ src/third_party/blink/renderer/core/helium_noise/geometry_policy_test.cc
@@ -0,0 +1,85 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+// -----------------------------------------------------------------------
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/geometry_policy.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace helium_noise {
+
+TEST(GeometryPolicyTest, ViewIsCapabilitySafeAndContained) {
+  GeometryInputs native{
+      .screen_dip = gfx::Rect(0, 0, 1920, 1080),
+      .available_dip = gfx::Rect(0, 0, 1920, 1040),
+      .window_dip = gfx::Rect(110, 90, 1400, 900),
+      .viewport_css = gfx::Size(1380, 820),
+      .device_pixel_ratio = 1.5,
+  };
+  const auto view = ComputeGeometryView(17, native);
+  ASSERT_TRUE(view);
+  EXPECT_LE(view->screen_dip.width(), native.screen_dip.width());
+  EXPECT_LE(view->screen_dip.height(), native.screen_dip.height());
+  EXPECT_LE(view->device_pixel_ratio, native.device_pixel_ratio);
+  EXPECT_TRUE(view->screen_dip.Contains(view->available_dip));
+  EXPECT_TRUE(view->screen_dip.Contains(view->window_dip));
+  EXPECT_LE(view->viewport_css.width(), native.viewport_css.width());
+  EXPECT_LE(view->viewport_css.height(), native.viewport_css.height());
+  EXPECT_LE(view->viewport_css.width(), view->window_dip.width());
+  EXPECT_LE(view->viewport_css.height(), view->window_dip.height());
+}
+
+TEST(GeometryPolicyTest, InvalidCoupledInputFailsOpenAsOneView) {
+  GeometryInputs native{
+      .screen_dip = gfx::Rect(0, 0, 0, 1080),
+      .available_dip = gfx::Rect(0, 0, 1920, 1040),
+      .window_dip = gfx::Rect(0, 0, 1200, 800),
+      .viewport_css = gfx::Size(1180, 720),
+      .device_pixel_ratio = 1.5,
+  };
+  EXPECT_FALSE(ComputeGeometryView(17, native));
+}
+
+TEST(GeometryPolicyTest, DeterministicForSameInputs) {
+  const GeometryInputs native{
+      .screen_dip = gfx::Rect(0, 0, 2560, 1440),
+      .available_dip = gfx::Rect(0, 0, 2560, 1400),
+      .window_dip = gfx::Rect(40, 20, 2000, 1300),
+      .viewport_css = gfx::Size(1990, 1390),
+      .device_pixel_ratio = 2.0,
+  };
+  const auto first = ComputeGeometryView(17, native);
+  const auto second = ComputeGeometryView(17, native);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_EQ(first->screen_dip, second->screen_dip);
+  EXPECT_EQ(first->window_dip.width(), second->window_dip.width());
+  EXPECT_EQ(first->device_pixel_ratio, second->device_pixel_ratio);
+}
+
+TEST(GeometryPolicyTest, NeverExceedsNative) {
+  GeometryInputs native{
+      .screen_dip = gfx::Rect(0, 0, 1920, 1080),
+      .available_dip = gfx::Rect(0, 0, 1920, 1040),
+      .window_dip = gfx::Rect(110, 90, 1400, 900),
+      .viewport_css = gfx::Size(1380, 820),
+      .device_pixel_ratio = 1.5,
+  };
+  const auto view = ComputeGeometryView(17, native);
+  ASSERT_TRUE(view);
+  EXPECT_LE(view->available_dip.width(), native.available_dip.width());
+  EXPECT_LE(view->available_dip.height(), native.available_dip.height());
+  EXPECT_LE(view->window_dip.width(), native.window_dip.width() +
+                                          10);  // quantization slack
+  EXPECT_LE(view->window_dip.height(), native.window_dip.height() + 10);
+  EXPECT_DOUBLE_EQ(view->screen_dip.x(), native.screen_dip.x());
+  EXPECT_DOUBLE_EQ(view->screen_dip.y(), native.screen_dip.y());
+}
+
+}  // namespace helium_noise
+}  // namespace blink
