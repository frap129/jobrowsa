+#include "third_party/blink/renderer/core/helium_noise/geometry_adapter.h"
+
+#include "base/feature_list.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/frame/local_frame_view.h"
+#include "third_party/blink/renderer/core/frame/settings.h"
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_profile.h"
+#include "third_party/blink/renderer/core/page/chrome_client.h"
+#include "ui/display/screen_info.h"
+#include "ui/gfx/geometry/size_f.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace helium_noise {
+
+namespace {
+
+// Gathers native geometry without calling any exposed accessor that routes
+// through this adapter (no recursion). Units are direct DIP/CSS-like
+// ScreenInfo and viewport values; physical-pixel quirks stay with the
+// consumers exactly as before.
+GeometryInputs GatherNativeGeometryWithoutCallingExposedAccessors(
+    LocalFrame& frame,
+    const display::ScreenInfo& screen_info) {
+  Page* page = frame.GetPage();
+  ChromeClient& chrome_client = page->GetChromeClient();
+  GeometryInputs native;
+  native.screen_dip = screen_info.rect;
+  native.available_dip = screen_info.available_rect;
+  native.window_dip = chrome_client.RootWindowRect(frame);
+  const gfx::SizeF viewport_mq = frame.View()->ViewportSizeForMediaQueries();
+  // innerWidth/innerHeight adjust the raw viewport by the layout zoom with
+  // the same absolute-zoom behavior; replicate without calling them.
+  native.viewport_css = gfx::Size(
+      static_cast<int>(static_cast<double>(viewport_mq.width()) /
+                       frame.LayoutZoomFactor()),
+      static_cast<int>(static_cast<double>(viewport_mq.height()) /
+                       frame.LayoutZoomFactor()));
+  // Exact Chromium 151 native DPR: inspector override times layout zoom.
+  native.device_pixel_ratio =
+      page->InspectorDeviceScaleFactorOverride() * frame.LayoutZoomFactor();
+  return native;
+}
+
+}  // namespace
+
+std::optional<GeometryView> GeometryViewForFrame(
+    LocalFrame& frame,
+    const display::ScreenInfo& screen_info) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumNoise) ||
+      !base::FeatureList::IsEnabled(features::kHeliumNoiseDisplay)) {
+    return std::nullopt;
+  }
+  auto* profile = HeliumNoiseProfile::From(frame.DomWindow());
+  if (!profile || !frame.GetPage() || !frame.View()) {
+    return std::nullopt;
+  }
+  return ComputeGeometryView(
+      profile->Hash(ProfileDomain::kDisplay),
+      GatherNativeGeometryWithoutCallingExposedAccessors(frame, screen_info));
+}
+
+}  // namespace helium_noise
+}  // namespace blink
