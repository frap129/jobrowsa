Index: src/third_party/blink/renderer/core/helium_noise/geometry_policy.cc
===================================================================
--- /dev/null
+++ src/third_party/blink/renderer/core/helium_noise/geometry_policy.cc
@@ -0,0 +1,224 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+// -----------------------------------------------------------------------
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/geometry_policy.h"
+
+#include <cmath>
+
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_hash.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+
+namespace blink {
+namespace helium_noise {
+
+namespace {
+
+// Exact ordered buckets; only the largest two eligible values are ever
+// selected.
+constexpr int kWidthBuckets[] = {800,  1024, 1280, 1366, 1440, 1536,
+                                 1600, 1920, 2560, 3200, 3840};
+constexpr int kHeightBuckets[] = {600,  720,  768,  800,  900,  1024,
+                                  1080, 1200, 1440, 1600, 1800, 2160};
+constexpr double kDprBuckets[] = {1.0,  1.25, 1.5,  1.75, 2.0,
+                                  2.25, 2.5,  3.0,  3.5,  4.0};
+
+// Distinct per-field tags keep derived fields from sharing a rotation.
+constexpr uint64_t kTagScreenWidth = 0x7700000000000001ULL;
+constexpr uint64_t kTagScreenHeight = 0x7700000000000003ULL;
+constexpr uint64_t kTagAvailableWidth = 0x7700000000000005ULL;
+constexpr uint64_t kTagAvailableHeight = 0x7700000000000009ULL;
+constexpr uint64_t kTagWindowWidth = 0x770000000000000bULL;
+constexpr uint64_t kTagWindowHeight = 0x770000000000000dULL;
+constexpr uint64_t kTagViewportWidth = 0x770000000000000fULL;
+constexpr uint64_t kTagViewportHeight = 0x7700000000000013ULL;
+constexpr uint64_t kTagWindowX = 0x7700000000000017ULL;
+constexpr uint64_t kTagWindowY = 0x7700000000000019ULL;
+constexpr uint64_t kTagDpr = 0x770000000000001bULL;
+
+int SelectBucket(uint64_t profile_hash,
+                 uint64_t field_tag,
+                 int native,
+                 const int* buckets,
+                 size_t bucket_count) {
+  if (native <= 0) {
+    return native;
+  }
+  int best = 0;
+  int second = 0;
+  size_t seen = 0;
+  for (size_t i = 0; i < bucket_count; ++i) {
+    if (buckets[i] <= native) {
+      if (seen == 0) {
+        best = buckets[i];
+        seen = 1;
+      } else if (seen == 1) {
+        second = best;
+        best = buckets[i];
+        seen = 2;
+      } else {
+        second = best;
+        best = buckets[i];
+      }
+    }
+  }
+  if (seen == 0) {
+    return native;
+  }
+  if (seen == 1) {
+    return best;
+  }
+  HeliumNoiseHash hash{HeliumNoiseToken(profile_hash)};
+  hash.Update(field_tag);
+  return hash.GetValueBelow(2) == 0 ? second : best;
+}
+
+double SelectDpr(uint64_t profile_hash, double native) {
+  if (native < 1.0 || !std::isfinite(native)) {
+    return native;
+  }
+  double best = 0.0;
+  double second = 0.0;
+  size_t seen = 0;
+  for (const double bucket : kDprBuckets) {
+    if (bucket <= native) {
+      if (seen == 0) {
+        best = bucket;
+        seen = 1;
+      } else if (seen == 1) {
+        second = best;
+        best = bucket;
+        seen = 2;
+      } else {
+        second = best;
+        best = bucket;
+      }
+    }
+  }
+  if (seen == 0) {
+    return native;
+  }
+  if (seen == 1) {
+    return best;
+  }
+  HeliumNoiseHash hash{HeliumNoiseToken(profile_hash)};
+  hash.Update(kTagDpr);
+  return hash.GetValueBelow(2) == 0 ? second : best;
+}
+
+bool Positive(const gfx::Rect& rect) {
+  return rect.width() > 0 && rect.height() > 0;
+}
+
+}  // namespace
+
+std::optional<GeometryView> ComputeGeometryView(uint64_t profile_hash,
+                                                const GeometryInputs& native) {
+  // One coupled validation of the native state; all consumers fail closed
+  // together rather than partially.
+  if (!Positive(native.screen_dip) || !Positive(native.available_dip) ||
+      !Positive(native.window_dip) || native.viewport_css.IsEmpty() ||
+      native.viewport_css.width() <= 0 || native.viewport_css.height() <= 0) {
+    return std::nullopt;
+  }
+  if (!std::isfinite(native.device_pixel_ratio) ||
+      native.device_pixel_ratio < 1.0) {
+    return std::nullopt;
+  }
+  if (!native.screen_dip.Contains(native.available_dip)) {
+    return std::nullopt;
+  }
+
+  // Screen: dimensions from buckets, origin unchanged.
+  const int screen_w = SelectBucket(profile_hash, kTagScreenWidth,
+                                    native.screen_dip.width(), kWidthBuckets,
+                                    std::size(kWidthBuckets));
+  const int screen_h = SelectBucket(profile_hash, kTagScreenHeight,
+                                    native.screen_dip.height(), kHeightBuckets,
+                                    std::size(kHeightBuckets));
+  const gfx::Rect view_screen(native.screen_dip.origin(),
+                              gfx::Size(screen_w, screen_h));
+
+  // Available: largest-two buckets against the native available rect, then
+  // clamped to fit inside the selected screen (right/bottom anchors
+  // preserved).
+  const int avail_w = SelectBucket(profile_hash, kTagAvailableWidth,
+                                   native.available_dip.width(), kWidthBuckets,
+                                   std::size(kWidthBuckets));
+  const int avail_h = SelectBucket(profile_hash, kTagAvailableHeight,
+                                   native.available_dip.height(),
+                                   kHeightBuckets, std::size(kHeightBuckets));
+  const int avail_w_clamped = std::min(avail_w, view_screen.width());
+  const int avail_h_clamped = std::min(avail_h, view_screen.height());
+  const int avail_x = std::max(view_screen.x(),
+                               std::min(native.available_dip.x(),
+                                        view_screen.right() - avail_w_clamped));
+  const int avail_y = std::max(view_screen.y(),
+                               std::min(native.available_dip.y(),
+                                        view_screen.bottom() - avail_h_clamped));
+  const gfx::Rect view_available(avail_x, avail_y, avail_w_clamped,
+                                 avail_h_clamped);
+  if (!view_screen.Contains(view_available)) {
+    return std::nullopt;
+  }
+
+  // Window: dimensions buckets against native window, clamped to fit the
+  // selected screen; origin quantized toward zero to a 10-DIP grid and then
+  // clamped inside the selected screen.
+  int win_w = SelectBucket(profile_hash, kTagWindowWidth,
+                           native.window_dip.width(), kWidthBuckets,
+                           std::size(kWidthBuckets));
+  int win_h = SelectBucket(profile_hash, kTagWindowHeight,
+                           native.window_dip.height(), kHeightBuckets,
+                           std::size(kHeightBuckets));
+  win_w = std::min(win_w, view_screen.width());
+  win_h = std::min(win_h, view_screen.height());
+  const auto quantize = [](int value) {
+    return (value / 10) * 10;
+  };
+  int win_x = quantize(native.window_dip.x());
+  int win_y = quantize(native.window_dip.y());
+  win_x = std::max(view_screen.x(),
+                   std::min(win_x, view_screen.right() - win_w));
+  win_y = std::max(view_screen.y(),
+                   std::min(win_y, view_screen.bottom() - win_h));
+  const gfx::Rect view_window(win_x, win_y, win_w, win_h);
+  if (!view_screen.Contains(view_window)) {
+    return std::nullopt;
+  }
+
+  // Viewport: buckets against native viewport, clamped inside the selected
+  // window.
+  const int view_w = SelectBucket(
+      profile_hash, kTagViewportWidth, native.viewport_css.width(),
+      kWidthBuckets, std::size(kWidthBuckets));
+  const int view_h = SelectBucket(
+      profile_hash, kTagViewportHeight, native.viewport_css.height(),
+      kHeightBuckets, std::size(kHeightBuckets));
+  const gfx::Size view_viewport(std::min(view_w, view_window.width()),
+                                std::min(view_h, view_window.height()));
+
+  GeometryView out;
+  out.screen_dip = view_screen;
+  out.available_dip = view_available;
+  out.window_dip = view_window;
+  out.viewport_css = view_viewport;
+  out.device_pixel_ratio = SelectDpr(profile_hash, native.device_pixel_ratio);
+  if (!(out.device_pixel_ratio > 0.0) ||
+      !std::isfinite(out.device_pixel_ratio) ||
+      out.device_pixel_ratio > native.device_pixel_ratio) {
+    return std::nullopt;
+  }
+  if (out.viewport_css.width() > native.viewport_css.width() ||
+      out.viewport_css.height() > native.viewport_css.height()) {
+    return std::nullopt;
+  }
+  return out;
+}
+
+}  // namespace helium_noise
+}  // namespace blink
