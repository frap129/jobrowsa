+
+namespace blink {
+namespace {
+
+class ScopedHeliumFeatures {
+ public:
+  ScopedHeliumFeatures(bool master, bool canvas) {
+    feature_list_.InitWithFeatureStates(
+        {{blink::features::kHeliumNoise, master},
+         {blink::features::kHeliumNoiseCanvas, canvas}});
+  }
+
+ private:
+  base::test::ScopedFeatureList feature_list_;
+};
+
+class CanvasNoisingHelperTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  ExecutionContext* Context() const {
+    ExecutionContext* context = GetDocument().GetExecutionContext();
+    EXPECT_TRUE(context);
+    return context;
+  }
+
+  void SetHighEntropyToken(uint64_t value) {
+    HeliumNoiseTokenMap tokens = GetPage().GetHeliumNoiseTokens();
+    tokens.insert_or_assign(HeliumNoiseFeature::kHighEntropy,
+                            HeliumNoiseToken(value));
+    GetPage().SetHeliumNoiseTokens(tokens);
+  }
+
+  void SetCompatibilityCanvasToken(uint64_t value) {
+    HeliumNoiseTokenMap tokens = GetPage().GetHeliumNoiseTokens();
+    tokens.insert_or_assign(HeliumNoiseFeature::kCanvas,
+                            HeliumNoiseToken(value));
+    GetPage().SetHeliumNoiseTokens(tokens);
+  }
+
+  scoped_refptr<StaticBitmapImage> MakeOpaqueRgba8888Image() {
+    SkBitmap bitmap;
+    bitmap.allocPixels(SkImageInfo::Make(8, 8, kRGBA_8888_SkColorType,
+                                         kOpaque_SkAlphaType));
+    for (int y = 0; y < 8; ++y) {
+      for (int x = 0; x < 8; ++x) {
+        uint8_t* pixel = static_cast<uint8_t*>(bitmap.getAddr(x, y));
+        for (size_t channel = 0; channel < 3; ++channel) {
+          pixel[channel] = static_cast<uint8_t>(
+              1 + (x * 31 + y * 17 + channel * 5) % 255);
+        }
+        pixel[3] = 255;
+      }
+    }
+    return UnacceleratedStaticBitmapImage::Create(bitmap.asImage());
+  }
+
+  std::vector<uint8_t> CopyPixels(scoped_refptr<StaticBitmapImage> image) {
+    SkImageInfo info = SkImageInfo::Make(
+        image->GetSize().width(), image->GetSize().height(),
+        kRGBA_8888_SkColorType, kUnpremul_SkAlphaType,
+        image->GetColorSpace().ToSkColorSpace());
+    std::vector<uint8_t> pixels(info.computeMinByteSize());
+    CHECK(image->PaintImageForCurrentFrame().readPixels(
+        info, pixels.data(), info.minRowBytes(), 0, 0));
+    return pixels;
+  }
+};
+
+TEST_F(CanvasNoisingHelperTest, MasterGateDisabledFailsOpen) {
+  ScopedHeliumFeatures features(/*master=*/false, /*canvas=*/true);
+  SetCompatibilityCanvasToken(23);
+  SetHighEntropyToken(17);
+  auto image = MakeOpaqueRgba8888Image();
+  const auto before = CopyPixels(image);
+  CanvasNoisingHelper::MaybeNoiseSnapshot(Context(), image);
+  EXPECT_EQ(before, CopyPixels(image));
+}
+
+TEST_F(CanvasNoisingHelperTest, HighEntropyTokenControlsRenderingNoise) {
+  ScopedHeliumFeatures features(/*master=*/true, /*canvas=*/true);
+  auto first = MakeOpaqueRgba8888Image();
+  auto second = MakeOpaqueRgba8888Image();
+  SetHighEntropyToken(17);
+  CanvasNoisingHelper::MaybeNoiseSnapshot(Context(), first);
+  SetHighEntropyToken(17);
+  CanvasNoisingHelper::MaybeNoiseSnapshot(Context(), second);
+  EXPECT_EQ(CopyPixels(first), CopyPixels(second));
+  EXPECT_NE(CopyPixels(MakeOpaqueRgba8888Image()), CopyPixels(first));
+}
+
+TEST_F(CanvasNoisingHelperTest, MissingProfileFailsOpen) {
+  ScopedHeliumFeatures features(/*master=*/true, /*canvas=*/true);
+  SetCompatibilityCanvasToken(23);
+  auto image = MakeOpaqueRgba8888Image();
+  const auto before = CopyPixels(image);
+  CanvasNoisingHelper::MaybeNoiseSnapshot(Context(), image);
+  EXPECT_EQ(before, CopyPixels(image));
+}
+
+}  // namespace
+}  // namespace blink
