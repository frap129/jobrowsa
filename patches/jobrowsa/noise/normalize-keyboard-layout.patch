+// US-ASCII writing-system map. The same map is reported for every host layout
+// so navigator.keyboard.getLayoutMap() cannot leak the physical keyboard
+// layout. Keys are W3C UI Events |code| values; values are the unshifted US
+// layout characters. Numpad, international and dead keys are omitted.
+struct UsAsciiKeyboardLayoutEntry {
+  const char* code;
+  const char* key;
+};
+
+constexpr UsAsciiKeyboardLayoutEntry kUsAsciiKeyboardLayout[] = {
+    {"KeyA", "a"},
+    {"KeyB", "b"},
+    {"KeyC", "c"},
+    {"KeyD", "d"},
+    {"KeyE", "e"},
+    {"KeyF", "f"},
+    {"KeyG", "g"},
+    {"KeyH", "h"},
+    {"KeyI", "i"},
+    {"KeyJ", "j"},
+    {"KeyK", "k"},
+    {"KeyL", "l"},
+    {"KeyM", "m"},
+    {"KeyN", "n"},
+    {"KeyO", "o"},
+    {"KeyP", "p"},
+    {"KeyQ", "q"},
+    {"KeyR", "r"},
+    {"KeyS", "s"},
+    {"KeyT", "t"},
+    {"KeyU", "u"},
+    {"KeyV", "v"},
+    {"KeyW", "w"},
+    {"KeyX", "x"},
+    {"KeyY", "y"},
+    {"KeyZ", "z"},
+    {"Digit0", "0"},
+    {"Digit1", "1"},
+    {"Digit2", "2"},
+    {"Digit3", "3"},
+    {"Digit4", "4"},
+    {"Digit5", "5"},
+    {"Digit6", "6"},
+    {"Digit7", "7"},
+    {"Digit8", "8"},
+    {"Digit9", "9"},
+    {"Backquote", "`"},
+    {"Minus", "-"},
+    {"Equal", "="},
+    {"BracketLeft", "["},
+    {"BracketRight", "]"},
+    {"Backslash", "\\"},
+    {"Semicolon", ";"},
+    {"Quote", "'"},
+    {"Comma", ","},
+    {"Period", "."},
+    {"Slash", "/"},
+    {"Space", " "},
+    {"Enter", "Enter"},
+    {"Tab", "Tab"},
+    {"Backspace", "Backspace"},
+};
+
+HashMap<String, String> UsAsciiKeyboardLayoutMap() {
+  HashMap<String, String> layout_map;
+  for (const auto& entry : kUsAsciiKeyboardLayout) {
+    layout_map.insert(String::FromUtf8(entry.code),
+                      String::FromUtf8(entry.key));
+  }
+  return layout_map;
+}
+
+bool ShouldNormalizeKeyboardLayout() {
+  return base::FeatureList::IsEnabled(blink::features::kHeliumNoise) &&
+         base::FeatureList::IsEnabled(
+             blink::features::kHeliumNoiseKeyboardLayout);
+}
