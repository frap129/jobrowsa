+TEST_F(DedicatedWorkerTest, InheritsCreatorHeliumNoiseTokens) {
+  GetDocument().GetExecutionContext()->SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(11)}});
+
+  StartWorker();
+  WaitUntilWorkerIsRunning();
+
+  RunOnWorkerThread(CrossThreadBindOnce(
+      [](ExecutionContext* worker_context) {
+        const HeliumNoiseTokenMap& tokens =
+            worker_context->GetHeliumNoiseTokens();
+        ASSERT_TRUE(tokens.contains(HeliumNoiseFeature::kHighEntropy));
+        EXPECT_EQ(tokens.at(HeliumNoiseFeature::kHighEntropy).Value(), 11u);
+      }));
+}
+
+TEST_F(DedicatedWorkerTest, EmptyCreatorMapFailsOpen) {
+  StartWorker();
+  WaitUntilWorkerIsRunning();
+
+  RunOnWorkerThread(CrossThreadBindOnce(
+      [](ExecutionContext* worker_context) {
+        EXPECT_TRUE(worker_context->GetHeliumNoiseTokens().empty());
+        EXPECT_EQ(helium_noise::HeliumNoiseProfile::From(worker_context),
+                  nullptr);
+      }));
+}
