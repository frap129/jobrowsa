+#include "third_party/blink/renderer/core/helium_noise/helium_noise_profile.h"
+
+#include <array>
+#include <bit>
+#include <cstdint>
+#include <ios>
+
+#include "base/containers/flat_set.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace {
+
+class HeliumNoiseProfileTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  ExecutionContext* Context() const {
+    ExecutionContext* context = GetDocument().GetExecutionContext();
+    EXPECT_TRUE(context);
+    return context;
+  }
+};
+
+TEST_F(HeliumNoiseProfileTest, MissingHighEntropyTokenFailsOpen) {
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kCanvas, HeliumNoiseToken(7)}});
+
+  EXPECT_EQ(helium_noise::HeliumNoiseProfile::From(Context()), nullptr);
+}
+
+TEST_F(HeliumNoiseProfileTest, DomainsAreStableAndSeparated) {
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(7)}});
+
+  helium_noise::HeliumNoiseProfile* profile =
+      helium_noise::HeliumNoiseProfile::From(Context());
+  ASSERT_NE(profile, nullptr);
+
+  EXPECT_EQ(profile->Hash(helium_noise::ProfileDomain::kText),
+            profile->Hash(helium_noise::ProfileDomain::kText));
+
+  base::flat_set<uint64_t> hashes = {
+      profile->Hash(helium_noise::ProfileDomain::kRendering),
+      profile->Hash(helium_noise::ProfileDomain::kWebGLCapability),
+      profile->Hash(helium_noise::ProfileDomain::kText),
+      profile->Hash(helium_noise::ProfileDomain::kFont),
+      profile->Hash(helium_noise::ProfileDomain::kDisplay),
+  };
+  EXPECT_EQ(hashes.size(), 5u);
+
+  // The domain constants must be pairwise distinct mod 8 (odd-flavored
+  // trailing bits), so that low-truncated hashes never share more than the
+  // lowest 2 bits between domains.
+  constexpr std::array<uint64_t, 5> kDomainValues = {
+      static_cast<uint64_t>(helium_noise::ProfileDomain::kRendering),
+      static_cast<uint64_t>(helium_noise::ProfileDomain::kWebGLCapability),
+      static_cast<uint64_t>(helium_noise::ProfileDomain::kText),
+      static_cast<uint64_t>(helium_noise::ProfileDomain::kFont),
+      static_cast<uint64_t>(helium_noise::ProfileDomain::kDisplay),
+  };
+  for (size_t i = 0; i < kDomainValues.size(); ++i) {
+    for (size_t j = i + 1; j < kDomainValues.size(); ++j) {
+      const uint64_t xor_value = kDomainValues[i] ^ kDomainValues[j];
+      EXPECT_LE(std::countr_zero(xor_value), 2)
+          << "domains " << i << " and " << j
+          << " share more than the lowest 2 bits";
+    }
+  }
+}
+
+TEST_F(HeliumNoiseProfileTest, DomainHashesDifferInLowBits) {
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(7)}});
+
+  helium_noise::HeliumNoiseProfile* profile =
+      helium_noise::HeliumNoiseProfile::From(Context());
+  ASSERT_NE(profile, nullptr);
+
+  constexpr std::array<uint64_t, 4> kTokens = {0x11, 0x22, 0x3333, 0x44445555};
+  constexpr std::array<helium_noise::ProfileDomain, 5> kDomains = {
+      helium_noise::ProfileDomain::kRendering,
+      helium_noise::ProfileDomain::kWebGLCapability,
+      helium_noise::ProfileDomain::kText,
+      helium_noise::ProfileDomain::kFont,
+      helium_noise::ProfileDomain::kDisplay,
+  };
+  for (uint64_t token : kTokens) {
+    GetPage().SetHeliumNoiseTokens(
+        {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(token)}});
+    profile = helium_noise::HeliumNoiseProfile::From(Context());
+    ASSERT_NE(profile, nullptr);
+    for (size_t i = 0; i < kDomains.size(); ++i) {
+      for (size_t j = i + 1; j < kDomains.size(); ++j) {
+        const uint64_t hash_i = profile->Hash(kDomains[i]);
+        const uint64_t hash_j = profile->Hash(kDomains[j]);
+        EXPECT_NE((hash_i ^ hash_j) & 0xFFFF, 0u)
+            << "token 0x" << std::hex << token << ": domains " << i << " and "
+            << j << " share identical low 16 bits";
+      }
+    }
+  }
+}
+
+TEST_F(HeliumNoiseProfileTest, TokenChangeInvalidatesCachedProfile) {
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(7)}});
+  const uint64_t text_hash_7 =
+      helium_noise::HeliumNoiseProfile::From(Context())
+          ->Hash(helium_noise::ProfileDomain::kText);
+
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(9)}});
+  const uint64_t text_hash_9 =
+      helium_noise::HeliumNoiseProfile::From(Context())
+          ->Hash(helium_noise::ProfileDomain::kText);
+
+  EXPECT_NE(text_hash_7, text_hash_9);
+}
+
+}  // namespace
+}  // namespace blink
