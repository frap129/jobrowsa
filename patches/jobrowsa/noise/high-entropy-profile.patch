+const HeliumNoiseTokenMap& LocalDOMWindow::GetHeliumNoiseTokens() const {
+  // Detached windows have no owning Page; fall back to the (empty) base map
+  // instead of dereferencing a null frame or page. Fails open.
+  if (!GetFrame() || !GetFrame()->GetPage()) {
+    return ExecutionContext::GetHeliumNoiseTokens();
+  }
+  return GetFrame()->GetPage()->GetHeliumNoiseTokens();
+}
+
+void LocalDOMWindow::SetHeliumNoiseTokens(const HeliumNoiseTokenMap& tokens) {
+  if (!GetFrame() || !GetFrame()->GetPage()) {
+    return;
+  }
+  GetFrame()->GetPage()->SetHeliumNoiseTokens(tokens);
+}
+
+helium_noise::HeliumNoiseProfile* LocalDOMWindow::GetHeliumNoiseProfile()
+    const {
+  if (!GetFrame() || !GetFrame()->GetPage()) {
+    return nullptr;
+  }
+  return GetFrame()->GetPage()->GetHeliumNoiseProfile();
+}
+
+void LocalDOMWindow::SetHeliumNoiseProfile(
+    helium_noise::HeliumNoiseProfile* profile) {
+  if (!GetFrame() || !GetFrame()->GetPage()) {
+    return;
+  }
+  GetFrame()->GetPage()->SetHeliumNoiseProfile(profile);
+}
