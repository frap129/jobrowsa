+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_HELIUM_NOISE_PROFILE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_HELIUM_NOISE_PROFILE_H_
+
+#include <cstdint>
+
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+
+namespace blink {
+
+class ExecutionContext;
+
+namespace helium_noise {
+
+// Fingerprinting-protection domains that derive independent pseudo-random
+// values from the context's high-entropy noise token. Each domain must yield
+// a stable value for a given token, and distinct domains must not correlate.
+// The constants are pairwise distinct mod 8 (odd-flavored trailing bits), so
+// low-truncated hashes never share more than the lowest 2 bits between
+// domains.
+enum class ProfileDomain : uint64_t {
+  kRendering = 0x72656e646572696eULL,
+  kWebGLCapability = 0x776562676c636170ULL,
+  kText = 0x7465787400000003ULL,
+  kFont = 0x666f6e7400000005ULL,
+  kDisplay = 0x646973706c617901ULL,
+};
+
+// A lazily-created, per-context profile that derives one stable hash per
+// fingerprinting domain from the context's high-entropy noise token. The
+// profile is invalidated whenever the owning context's token map changes.
+class CORE_EXPORT HeliumNoiseProfile final
+    : public GarbageCollected<HeliumNoiseProfile> {
+ public:
+  // Returns the profile for |context|, or nullptr when the context has no
+  // high-entropy token (fails open).
+  static HeliumNoiseProfile* From(ExecutionContext* context);
+
+  // Returns the stable hash for |domain|, derived from the high-entropy
+  // token and the domain value. Stable for a given token and independent
+  // across domains.
+  uint64_t Hash(ProfileDomain domain) const;
+
+  void Trace(Visitor* visitor) const {}
+
+ private:
+  friend class cppgc::MakeGarbageCollectedTrait<HeliumNoiseProfile>;
+
+  explicit HeliumNoiseProfile(HeliumNoiseToken token);
+
+  HeliumNoiseToken token_;
+};
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_HELIUM_NOISE_PROFILE_H_
