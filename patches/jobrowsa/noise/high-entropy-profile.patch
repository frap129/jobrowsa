+namespace blink {
+namespace helium_noise {
+
+// static
+HeliumNoiseProfile* HeliumNoiseProfile::From(ExecutionContext* context) {
+  if (!context) {
+    return nullptr;
+  }
+  const HeliumNoiseTokenMap& tokens = context->GetHeliumNoiseTokens();
+  if (!tokens.contains(HeliumNoiseFeature::kHighEntropy)) {
+    return nullptr;
+  }
+  if (HeliumNoiseProfile* profile = context->GetHeliumNoiseProfile()) {
+    return profile;
+  }
+  HeliumNoiseProfile* profile = MakeGarbageCollected<HeliumNoiseProfile>(
+      tokens.at(HeliumNoiseFeature::kHighEntropy));
+  context->SetHeliumNoiseProfile(profile);
+  return profile;
+}
+
+uint64_t HeliumNoiseProfile::Hash(ProfileDomain domain) const {
+  HeliumNoiseHash hash(token_);
+  hash.Update(static_cast<uint64_t>(domain));
+  return hash.GetValue();
+}
