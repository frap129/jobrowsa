+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_COMMON_HELIUM_NOISE_WINDOWS_IDENTITY_H_
+#define THIRD_PARTY_BLINK_PUBLIC_COMMON_HELIUM_NOISE_WINDOWS_IDENTITY_H_
+
+#include "base/feature_list.h"
+#include "build/build_config.h"
+#include "third_party/blink/public/common/features.h"
+
+namespace blink {
+namespace helium_noise {
+
+// The Windows identity presents a Windows 11 x86_64 stock-Chromium fingerprint
+// on a host that is not Windows. It is only applied on Linux; other platforms
+// keep their native Chromium identity. Whether arm64 hosts also present the
+// x86_64 identity is decided by the platform/UA landing.
+inline bool IsWindowsIdentityPlatformSupported() {
+#if BUILDFLAG(IS_LINUX)
+  return true;
+#else
+  return false;
+#endif
+}
+
+// The single gate for every Windows-identity surface (platform/user agent and
+// system fonts). The master Helium Noise feature, the Windows-identity
+// subfeature, and a supported platform must all be on; any failure returns
+// false so callers fall back to stock Chromium behavior.
+inline bool IsWindowsIdentityEnabled() {
+  return IsWindowsIdentityPlatformSupported() &&
+         base::FeatureList::IsEnabled(features::kHeliumNoise) &&
+         base::FeatureList::IsEnabled(features::kHeliumNoiseWindowsIdentity);
+}
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_COMMON_HELIUM_NOISE_WINDOWS_IDENTITY_H_
