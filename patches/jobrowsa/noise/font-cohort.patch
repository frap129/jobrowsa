+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/font_cohort.h"
+
+#include <array>
+
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace helium_noise {
+namespace {
+
+bool ContainsClass(const Vector<uint8_t>& selected,
+                   FontGenericClass generic_class) {
+  for (const uint8_t index : selected) {
+    if (ApprovedFontIdentities()[index].generic_class == generic_class) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+TEST(FontCohortTest, TableIsFixedAndWithinCaps) {
+  const auto table = ApprovedFontIdentities();
+  EXPECT_EQ(9u, table.size());
+  size_t names = 0;
+  for (const FontIdentity& identity : table) {
+    names += 1;
+    names += identity.aliases[0][0] != '\0';
+    names += identity.aliases[1][0] != '\0';
+  }
+  EXPECT_EQ(15u, names);
+  EXPECT_LE(names, 16u);
+}
+
+TEST(FontCohortTest, SelectionIsBoundedInstalledAndClassCovering) {
+  const std::array<uint8_t, 9> available{0, 1, 2, 3, 4, 5, 6, 7, 8};
+  const Vector<uint8_t> selected = SelectFontCohort(17, available);
+  EXPECT_LE(selected.size(), 8u);
+  for (const uint8_t index : selected) {
+    EXPECT_THAT(available, testing::Contains(index));
+  }
+  EXPECT_TRUE(ContainsClass(selected, FontGenericClass::kSans));
+  EXPECT_TRUE(ContainsClass(selected, FontGenericClass::kSerif));
+  EXPECT_TRUE(ContainsClass(selected, FontGenericClass::kMonospace));
+}
+
+TEST(FontCohortTest, InvalidOrEmptyAvailabilityFailsOpen) {
+  EXPECT_TRUE(SelectFontCohort(17, {}).empty());
+  const std::array<uint8_t, 2> duplicate{1, 1};
+  EXPECT_TRUE(SelectFontCohort(17, duplicate).empty());
+  const std::array<uint8_t, 1> out_of_range{9};
+  EXPECT_TRUE(SelectFontCohort(17, out_of_range).empty());
+}
+
+TEST(FontCohortTest, ResolverCreationAndResolution) {
+  const std::array<uint8_t, 3> available{0, 1, 2};
+  const auto resolver = FontCohortResolver::Create(17, available);
+  ASSERT_NE(resolver, nullptr);
+  // Alias of row 0 must be allowed; unknown families are not.
+  EXPECT_TRUE(resolver->Allows("Arial"));
+  EXPECT_TRUE(resolver->Allows("arial"));
+  EXPECT_TRUE(resolver->Allows("LibERATion sans"));
+  EXPECT_FALSE(resolver->Allows("Fingerprint Test Font"));
+  EXPECT_EQ(AtomicString("Arial"), resolver->Resolve(
+                                       FontGenericClass::kSans,
+                                       AtomicString("Arial")));
+  EXPECT_FALSE(
+      resolver
+          ->Resolve(FontGenericClass::kSans, AtomicString("Fingerprint Test Font"))
+          .empty());
+}
+
+TEST(FontCohortTest, EmptySelectionRejectsCreate) {
+  const auto resolver = FontCohortResolver::Create(17, {});
+  EXPECT_EQ(resolver, nullptr);
+}
+
+}  // namespace helium_noise
+}  // namespace blink
