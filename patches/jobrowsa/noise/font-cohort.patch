+TEST_F(CanvasFontCacheTest, SystemFamilyUsesSelectedRepresentative) {
+  // Install only the three Liberation identities as "installed" fonts.
+  helium_noise::ScopedFontCohortAvailabilityForTesting scoped_availability(
+      base::BindRepeating([]() -> Vector<uint8_t> { return {0, 1, 2}; }));
+  GetPage().SetHeliumNoiseTokens(
+      {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(17)}});
+  // The cohort gate opens for this document, so canvas font resolution goes
+  // through the document selector's cohort resolver: an unapproved name is
+  // not allowed, and the sans representative is the single available sans
+  // identity (Liberation Sans), independent of row order and host fonts.
+  auto resolver = helium_noise::GetFontCohortResolver(
+      GetDocument().GetExecutionContext());
+  ASSERT_TRUE(resolver);
+  EXPECT_FALSE(resolver->Allows("Fingerprint Test Font"));
+  EXPECT_EQ(AtomicString("Liberation Sans"),
+            resolver->Resolve(helium_noise::ToFontGenericClass(
+                                  FontDescription::kSansSerifFamily),
+                              AtomicString("Fingerprint Test Font")));
+  // The availability query CanvasFontCache-backed font resolution consults
+  // must reject the unapproved name through the same resolver.
+  CSSFontSelector* font_selector =
+      GetDocument().GetStyleEngine().GetFontSelector();
+  ASSERT_TRUE(font_selector);
+  const FontDescription description;
+  EXPECT_FALSE(font_selector->IsPlatformFamilyMatchAvailable(
+      description, FontFamily(AtomicString("Fingerprint Test Font"),
+                           FontFamily::Type::kFamilyName)));
+  EXPECT_TRUE(font_selector->IsPlatformFamilyMatchAvailable(
+      description, FontFamily(AtomicString("Arial"), FontFamily::Type::kFamilyName)));
 }
 
