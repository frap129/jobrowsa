+namespace blink {
+namespace {
+
+// Frozen tuple the Network Information API reports while the freeze gate is
+// active: a quiet desktop Chrome on wifi.
+constexpr uint32_t kFrozenRttMsec = 50;
+constexpr double kFrozenDownlink = 10.0;
+
+class NetworkInformationFreezeTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  void TearDown() override {
+    GetNetworkStateNotifier().ClearOverride();
+    scoped_feature_list_.reset();
+    PageTestBase::TearDown();
+  }
+
+  void EnableFreeze() { ApplyFeatureStates(true, true); }
+
+  void DisableMasterFeature() { ApplyFeatureStates(false, true); }
+
+  NetworkInformation* Connection() {
+    NetworkInformation* connection =
+        NetworkInformation::connection(*GetDocument().domWindow()->navigator());
+    EXPECT_TRUE(connection);
+    return connection;
+  }
+
+  // Pushes a full network-state change through the notifier so any live
+  // observers (none under the freeze) would observe it.
+  void PushNetworkStateChange() {
+    NetworkStateNotifier& notifier = GetNetworkStateNotifier();
+    notifier.SetWebConnection(kWebConnectionTypeCellular3G, 1.5);
+    notifier.SetNetworkQuality(WebEffectiveConnectionType::kType2G,
+                               base::Milliseconds(800), base::Milliseconds(400),
+                               100);
+    notifier.SetSaveDataEnabled(true);
+  }
+
+ private:
+  void ApplyFeatureStates(bool master, bool sub) {
+    scoped_feature_list_.reset();
+    scoped_feature_list_ = std::make_unique<base::test::ScopedFeatureList>();
+    scoped_feature_list_->InitWithFeatureStates(
+        {{blink::features::kHeliumNoise, master},
+         {blink::features::kHeliumNoiseNetworkInformation, sub}});
+  }
+
+  std::unique_ptr<base::test::ScopedFeatureList> scoped_feature_list_;
+};
+
+// Fresh context exposes the frozen desktop tuple on every accessor.
+TEST_F(NetworkInformationFreezeTest, FreshContextReportsFrozenTuple) {
+  EnableFreeze();
+  NetworkInformation* connection = Connection();
+  EXPECT_EQ(V8ConnectionType::Enum::kWifi, connection->type().AsEnum());
+  EXPECT_EQ(V8EffectiveConnectionType::Enum::k4G,
+            connection->effectiveType().AsEnum());
+  EXPECT_EQ(kFrozenRttMsec, connection->rtt());
+  EXPECT_EQ(kFrozenDownlink, connection->downlink());
+  EXPECT_EQ(kFrozenDownlink, connection->downlinkMax());
+  EXPECT_FALSE(connection->saveData());
+}
+
+// The freeze must ride out a real network-state push with no change event,
+// no observer registration, and no pending-activity lifetime extension.
+TEST_F(NetworkInformationFreezeTest, NetworkPushNeverFiresChangeOrObserves) {
+  EnableFreeze();
+  NetworkInformation* connection = Connection();
+
+  PushNetworkStateChange();
+
+  EXPECT_FALSE(connection->HasEventListeners());
+  EXPECT_FALSE(connection->HasPendingActivity());
+  EXPECT_EQ(V8ConnectionType::Enum::kWifi, connection->type().AsEnum());
+  EXPECT_EQ(V8EffectiveConnectionType::Enum::k4G,
+            connection->effectiveType().AsEnum());
+  EXPECT_EQ(kFrozenRttMsec, connection->rtt());
+  EXPECT_EQ(kFrozenDownlink, connection->downlink());
+}
+
+// DevTools network emulation rides the NetworkStateNotifier override seam;
+// the freeze must not shadow it while it is active.
+TEST_F(NetworkInformationFreezeTest, DevToolsEmulationOverridesFrozenValues) {
+  EnableFreeze();
+  NetworkInformation* connection = Connection();
+
+  GetNetworkStateNotifier().SetNetworkConnectionInfoOverride(
+      /*on_line=*/true, kWebConnectionTypeCellular3G,
+      WebEffectiveConnectionType::kType3G, /*http_rtt_msec=*/800,
+      /*max_bandwidth_mbps=*/1.5);
+
+  EXPECT_EQ(V8ConnectionType::Enum::kCellular, connection->type().AsEnum());
+  EXPECT_EQ(V8EffectiveConnectionType::Enum::k3G,
+            connection->effectiveType().AsEnum());
+  EXPECT_EQ(800u, connection->rtt());
+  EXPECT_EQ(1.5, connection->downlinkMax());
+  EXPECT_EQ(1.5, connection->downlink());
+
+  EXPECT_TRUE(GetNetworkStateNotifier().HasOverride());
+  GetNetworkStateNotifier().ClearOverride();
+  EXPECT_EQ(V8ConnectionType::Enum::kWifi, connection->type().AsEnum());
+  EXPECT_EQ(V8EffectiveConnectionType::Enum::k4G,
+            connection->effectiveType().AsEnum());
+  EXPECT_EQ(kFrozenRttMsec, connection->rtt());
+}
+
+// With the master gate off the whole freeze fails open to native values,
+// which track whatever the notifier reports.
+TEST_F(NetworkInformationFreezeTest, MasterFeatureOffReportsNativeValues) {
+  DisableMasterFeature();
+  NetworkInformation* connection = Connection();
+
+  PushNetworkStateChange();
+
+  EXPECT_EQ(V8ConnectionType::Enum::kCellular, connection->type().AsEnum());
+  EXPECT_EQ(V8EffectiveConnectionType::Enum::k2G,
+            connection->effectiveType().AsEnum());
+  EXPECT_FALSE(connection->saveData()) << "saveData stays false because the "
+                                          "notifier SaveDataEnabled is false "
+                                          "in this test environment";
+  EXPECT_EQ(0u, connection->rtt()) << "native HTTP RTT is unset in the test "
+                                      "notifier, so it rounds to 0";
+}
