   enum FontType {
@@ -241,4 +262,17 @@ TEST_P(CaretPositionForOffsetBidiTest, C
   }
 }
 
+TEST(TextMetricsTest, ShuffleMapsHorizontalAndVerticalFactors) {
+  TextMetrics* metrics = MakeMetricsForTesting(
+      /*width=*/10, /*left=*/2, /*right=*/3,
+      /*ascent=*/4, /*descent=*/5, /*alphabetic_baseline=*/6);
+  metrics->Shuffle(2.0, 3.0);
+  EXPECT_EQ(20, metrics->width());
+  EXPECT_EQ(4, metrics->actualBoundingBoxLeft());
+  EXPECT_EQ(6, metrics->actualBoundingBoxRight());
+  EXPECT_EQ(12, metrics->actualBoundingBoxAscent());
