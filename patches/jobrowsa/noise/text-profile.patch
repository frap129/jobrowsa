+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_POLICY_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_POLICY_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+namespace helium_noise {
+
+// Pair of multiplicative text-geometry factors derived from a profile hash.
+// |x| scales horizontal metrics (width, left, right); |y| scales vertical
+// metrics (ascent, descent, em heights, baselines). Both factors stay within
+// 1.0 +/- 1.5e-6 and equal 1.0 when text protection is inactive.
+struct TextAxisFactors {
+  double x;
+  double y;
+};
+
+// Derives the stable, axis-separated text factors from |profile_hash|.
+// Pure: same hash, same factors; distinct hashes never share factors.
+CORE_EXPORT TextAxisFactors ComputeTextAxisFactors(uint64_t profile_hash);
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_TEXT_POLICY_H_
