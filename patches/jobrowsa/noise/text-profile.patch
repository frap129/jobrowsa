+#include "third_party/blink/renderer/core/helium_noise/text_policy.h"
+
+#include <cmath>
+#include <cstdint>
+
+#include "base/test/scoped_feature_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/helium_noise/helium_noise_profile.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace helium_noise {
+namespace {
+
+class TextPolicyTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  ExecutionContext* Context() const {
+    ExecutionContext* context = GetDocument().GetExecutionContext();
+    EXPECT_TRUE(context);
+    return context;
+  }
+
+  void SetHighEntropyToken(uint64_t value) {
+    GetPage().SetHeliumNoiseTokens(
+        {{HeliumNoiseFeature::kHighEntropy, HeliumNoiseToken(value)}});
+  }
+};
+
+TEST_F(TextPolicyTest, FactorsAreStableBoundedAndAxisSeparated) {
+  const TextAxisFactors first = ComputeTextAxisFactors(17);
+  const TextAxisFactors second = ComputeTextAxisFactors(17);
+  EXPECT_EQ(first.x, second.x);
+  EXPECT_EQ(first.y, second.y);
+  EXPECT_LE(std::abs(first.x - 1.0), 1.5e-6);
+  EXPECT_LE(std::abs(first.y - 1.0), 1.5e-6);
+}
+
+TEST_F(TextPolicyTest, TextFactorsFailOpenAndFollowProfile) {
+  // Master gate off: the document must fail open to 1.0 on both axes even
+  // with a profile token present.
+  base::test::ScopedFeatureList features_off;
+  features_off.InitWithFeatureStates(
+      {{blink::features::kHeliumNoise, false},
+       {blink::features::kHeliumNoiseTextGeometry, true}});
+  SetHighEntropyToken(17);
+  EXPECT_EQ(1.0, GetDocument().GetNoiseFactorX());
+  EXPECT_EQ(1.0, GetDocument().GetNoiseFactorY());
+
+  // Full chain on: the text factors must follow the kText profile domain
+  // exactly, on both axes, and remain stable across repeated calls.
+  base::test::ScopedFeatureList features_on;
+  features_on.InitWithFeatureStates(
+      {{blink::features::kHeliumNoise, true},
+       {blink::features::kHeliumNoiseTextGeometry, true}});
+  SetHighEntropyToken(17);
+  const HeliumNoiseProfile* profile = HeliumNoiseProfile::From(Context());
+  ASSERT_NE(profile, nullptr);
+  const TextAxisFactors factors = ComputeTextAxisFactors(
+      profile->Hash(helium_noise::ProfileDomain::kText));
+  EXPECT_EQ(factors.x, GetDocument().GetNoiseFactorX());
+  EXPECT_EQ(factors.y, GetDocument().GetNoiseFactorY());
+}
+
+}  // namespace
+}  // namespace helium_noise
+}  // namespace blink
Index: src/third_party/blink/renderer/core/helium_noise/text_policy.cc
