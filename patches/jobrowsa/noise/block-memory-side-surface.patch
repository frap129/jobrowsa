+// Returns whether the memory-side probing surface is blocked by Helium Noise.
+bool ShouldBlockMemorySurface() {
+  return base::FeatureList::IsEnabled(blink::features::kHeliumNoise) &&
+         base::FeatureList::IsEnabled(
+             blink::features::kHeliumNoiseMemorySurface);
+}
+
 ApiStatus CheckMeasureMemoryAvailability() {
+  if (ShouldBlockMemorySurface()) {
+    return ApiStatus::kNotAvailableDueToFlag;
+  }
   if (!RuntimeEnabledFeatures::PerformanceManagerInstrumentationEnabled()) {
     return ApiStatus::kNotAvailableDueToResourceCoordinator;
   }

