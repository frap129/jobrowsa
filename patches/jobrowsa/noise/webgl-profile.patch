+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_WEBGL_CAPABILITY_POLICY_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_WEBGL_CAPABILITY_POLICY_H_
+
+#include <cstdint>
+#include <optional>
+
+#include "base/containers/flat_map.h"
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/khronos/GLES3/gl3.h"
+
+namespace blink {
+namespace helium_noise {
+
+enum class WebGLVersion { k1, k2 };
+
+struct WebGLLimit {
+  GLenum pname;
+  GLint64 value;
+};
+
+struct WebGLCapabilityView {
+  base::flat_map<GLenum, GLint64> limits;
+  GLint max_viewport_width;
+  GLint max_viewport_height;
+};
+
+// One capability row across the three locked tiers (low/medium/high).
+struct WebGLCapabilityRow {
+  GLenum pname;
+  GLint64 low;
+  GLint64 medium;
+  GLint64 high;
+};
+
+// Validates the native limit map and selects one complete capability-safe
+// row. Validation rejects missing, duplicated, unknown, non-negative-violating
+// or overflowing required pnames; rows are filtered componentwise against the
+// native limits (viewport axes included) and one of the surviving rows is
+// picked deterministically from the WebGLCapability-domain profile hash.
+// Returns nullopt when nothing is eligible (fail open).
+CORE_EXPORT std::optional<WebGLCapabilityView> SelectWebGLCapabilityView(
+    uint64_t profile_hash,
+    WebGLVersion version,
+    const base::flat_map<GLenum, GLint64>& native_limits,
+    GLint native_max_viewport_width,
+    GLint native_max_viewport_height);
+
+enum class RendererClass { kSoftware, kIntel, kAmd, kNvidia, kUnknown };
+
+// Canonical vendor/renderer pair vended for a hardware class. The pointers
+// stay owned by the locked canonical arrays; they are never freed and remain
+// valid for the process lifetime.
+struct CanonicalRendererInfo {
+  const char* vendor;
+  const char* renderer;
+};
+
+// Classifies the native GL vendor/renderer strings. Software renderers are
+// matched first (SwiftShader, Mesa llvmpipe/softpipe), then Intel, AMD and
+// NVIDIA markers; anything else is kUnknown.
+CORE_EXPORT RendererClass ClassifyRenderer(const char* vendor,
+                                           const char* renderer);
+
+// Locked class-specific canonical strings picked deterministically from the
+// WebGLCapability-domain profile hash. kUnknown has no canonical row and
+// fails open.
+CORE_EXPORT std::optional<CanonicalRendererInfo> SelectCanonicalRendererInfo(
+    uint64_t profile_hash,
+    RendererClass renderer_class);
+
+// The immutable locked row tables. |CapabilityRows| backs the selection
+// policy; the ForTesting aliases are what the unit tests consume.
+CORE_EXPORT base::span<const WebGLCapabilityRow> CapabilityRows(
+    WebGLVersion version);
+CORE_EXPORT base::span<const WebGLCapabilityRow> WebGL1DrawBufferRows();
+inline base::span<const WebGLCapabilityRow> AllCapabilityRowsForTesting(
+    WebGLVersion version) {
+  return CapabilityRows(version);
+}
+inline base::span<const WebGLCapabilityRow> AllWebGL1DrawBufferRowsForTesting() {
+  return WebGL1DrawBufferRows();
+}
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_WEBGL_CAPABILITY_POLICY_H_
