+
+// RED (Task 3): pure WebGL capability policy tests. The locked production
+// interface in webgl_capability_policy.h (namespace blink::helium_noise) is
+// implemented by the GREEN step; until then this file fails to compile,
+// which is the expected RED state.
+
+#include <cstdint>
+
+#include "base/containers/flat_map.h"
+#include "base/containers/span.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/renderer/core/helium_noise/webgl_capability_policy.h"
+#include "third_party/khronos/GLES3/gl3.h"
+
+using ::testing::HasSubstr;
+
+namespace blink {
+namespace helium_noise {
+namespace {
+
+// Native GPU limit set handed to SelectWebGLCapabilityView; kept local so the
+// tests never depend on production test plumbings.
+struct NativeLimitsForTest {
+  base::flat_map<GLenum, GLint64> limits;
+  GLint viewport_width = 0;
+  GLint viewport_height = 0;
+};
+
+GLint64 NativeValue(const NativeLimitsForTest& native, GLenum pname) {
+  return native.limits.at(pname);
+}
+
+void SetNativeValue(NativeLimitsForTest& native,
+                    GLenum pname,
+                    GLint64 value) {
+  native.limits.insert_or_assign(pname, value);
+}
+
+const WebGLCapabilityRow* FindRow(base::span<const WebGLCapabilityRow> rows,
+                                  GLenum pname) {
+  for (const auto& row : rows) {
+    if (row.pname == pname) {
+      return &row;
+    }
+  }
+  return nullptr;
+}
+
+// Builds a complete, validated native limit set from the exported-for-testing
+// row table: every required pname appears exactly once with a strictly
+// positive value |margin| above the tier |offset| row (offset 2 = high, 0 =
+// low), so no row is filtered out unless stated.
+NativeLimitsForTest MakeNativeLimitsAboveTier(WebGLVersion version,
+                                              int offset,
+                                              GLint64 margin) {
+  NativeLimitsForTest native;
+  const auto rows = AllCapabilityRowsForTesting(version);
+  for (const auto& row : rows) {
+    const GLint64 tier_value = offset == 0 ? row.low
+                               : offset == 1
+                                   ? row.medium
+                                   : row.high;
+    native.limits.insert_or_assign(row.pname, tier_value + margin);
+  }
+  const WebGLCapabilityRow* viewport = FindRow(rows, GL_MAX_VIEWPORT_DIMS);
+  // Note: the row is exported by GREEN; the margin keeps the native viewport
+  // strictly above every tier row in both axes.
+  const GLint64 viewport_bound = (viewport ? viewport->high : 16384) + margin;
+  native.viewport_width = static_cast<GLint>(viewport_bound);
+  native.viewport_height = native.viewport_width;
+  return native;
+}
+
+NativeLimitsForTest MakeNativeLimitsAboveHighTier(WebGLVersion version) {
+  return MakeNativeLimitsAboveTier(version, 2, 4096);
+}
+
+// Native set sitting just above the LOW tier: the low row stays eligible, the
+// high rows do not. Used by the fail-open tests where only the parse/validate
+// path matters.
+NativeLimitsForTest MakeNativeLimitsAboveLowTier(WebGLVersion version) {
+  return MakeNativeLimitsAboveTier(version, 0, 1024);
+}
+
+}  // namespace
+
+// The selected view must never report a limit above the native GPU value,
+// including both viewport axes, and draw buffers must never exceed color
+// attachments (a framebuffer larger than the attachment list would corrupt
+// rendering).
+TEST(WebGLCapabilityPolicyTest, SelectsOnlyCompleteCapabilitySafeRows) {
+  const auto native = MakeNativeLimitsAboveHighTier(WebGLVersion::k2);
+  const auto view = SelectWebGLCapabilityView(
+      17, WebGLVersion::k2, native.limits, native.viewport_width,
+      native.viewport_height);
+  ASSERT_TRUE(view);
+  for (const auto& [pname, reported] : view->limits)
+    EXPECT_LE(reported, NativeValue(native, pname));
+  EXPECT_LE(view->max_viewport_width, native.viewport_width);
+  EXPECT_LE(view->max_viewport_height, native.viewport_height);
+  EXPECT_EQ(view->limits.at(GL_MAX_DRAW_BUFFERS),
+            view->limits.at(GL_MAX_COLOR_ATTACHMENTS));
+}
+
+// A native set that misses a required pname, or undershoots the smallest
+// complete tier, must fail open (no view reported) instead of inventing
+// values.
+TEST(WebGLCapabilityPolicyTest, MissingOrTooSmallInputFailsOpen) {
+  auto native = MakeNativeLimitsAboveLowTier(WebGLVersion::k2);
+  native.limits.erase(native.limits.begin());
+  EXPECT_FALSE(SelectWebGLCapabilityView(
+      17, WebGLVersion::k2, native.limits, native.viewport_width,
+      native.viewport_height));
+  native = MakeNativeLimitsAboveLowTier(WebGLVersion::k2);
+  SetNativeValue(native, GL_MAX_TEXTURE_SIZE, 1024);
+  EXPECT_FALSE(SelectWebGLCapabilityView(
+      17, WebGLVersion::k2, native.limits, native.viewport_width,
+      native.viewport_height));
+}
+
+// Canonical renderer strings must preserve the hardware class: the spoofed /
+// classified renderer stays within its tier family, and unknown classes fail
+// open. Placeholder canonical rows intentionally keep the vendor marker so
+// class preservation is observable.
+TEST(WebGLCapabilityPolicyTest, RendererCanonicalizationPreservesClass) {
+  EXPECT_EQ(RendererClass::kSoftware,
+            ClassifyRenderer("Google Inc.", "ANGLE SwiftShader"));
+  EXPECT_EQ(RendererClass::kAmd, ClassifyRenderer("AMD", "Radeon RX"));
+  EXPECT_FALSE(SelectCanonicalRendererInfo(17, RendererClass::kUnknown));
+  EXPECT_THAT(SelectCanonicalRendererInfo(17, RendererClass::kNvidia)->renderer,
+              HasSubstr("NVIDIA"));
+}
+
+// Every locked tier row of BOTH versions must satisfy the GL cross-limit
+// identities, so no selected view can hand out a self-contradicting
+// capability set. Rows are read only through the exported-for-testing
+// immutable spans; no tier constants are duplicated here.
+TEST(WebGLCapabilityPolicyTest, EveryTierSatisfiesCrossLimitRelations) {
+  for (WebGLVersion version : {WebGLVersion::k1, WebGLVersion::k2}) {
+    const auto rows = AllCapabilityRowsForTesting(version);
+    ASSERT_FALSE(rows.empty());
+    // The viewport-axes row must exist in both versions; a single row value
+    // governs both axes, so per-axis consistency reduces to row monotonicity.
+    EXPECT_NE(FindRow(rows, GL_MAX_VIEWPORT_DIMS), nullptr);
+    for (const auto& row : rows) {
+      // Tiers are monotonic and non-negative; zero is legal only for the
+      // WebGL1 vertex texture image unit row.
+      EXPECT_LE(row.low, row.medium);
+      EXPECT_LE(row.medium, row.high);
+      if (row.low == 0) {
+        EXPECT_EQ(version, WebGLVersion::k1);
+        EXPECT_EQ(row.pname, GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS);
+      }
+    }
+    // Combined texture image units must cover both shader stages.
+    const WebGLCapabilityRow* combined_units =
+        FindRow(rows, GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS);
+    const WebGLCapabilityRow* fragment_units =
+        FindRow(rows, GL_MAX_TEXTURE_IMAGE_UNITS);
+    const WebGLCapabilityRow* vertex_units =
+        FindRow(rows, GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS);
+    if (combined_units && fragment_units && vertex_units) {
+      EXPECT_GE(combined_units->low, fragment_units->low + vertex_units->low);
+      EXPECT_GE(combined_units->medium,
+                fragment_units->medium + vertex_units->medium);
+      EXPECT_GE(combined_units->high,
+                fragment_units->high + vertex_units->high);
+    }
+    // Combined uniform component counts cover the full uniform-block
+    // footprint (GLES3: block size/4 components per block + default block).
+    const WebGLCapabilityRow* block_size =
+        FindRow(rows, GL_MAX_UNIFORM_BLOCK_SIZE);
+    const WebGLCapabilityRow* vertex_blocks =
+        FindRow(rows, GL_MAX_VERTEX_UNIFORM_BLOCKS);
+    const WebGLCapabilityRow* vertex_components =
+        FindRow(rows, GL_MAX_VERTEX_UNIFORM_COMPONENTS);
+    const WebGLCapabilityRow* vertex_combined =
+        FindRow(rows, GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS);
+    const WebGLCapabilityRow* fragment_blocks =
+        FindRow(rows, GL_MAX_FRAGMENT_UNIFORM_BLOCKS);
+    const WebGLCapabilityRow* fragment_components =
+        FindRow(rows, GL_MAX_FRAGMENT_UNIFORM_COMPONENTS);
+    const WebGLCapabilityRow* fragment_combined =
+        FindRow(rows, GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS);
+    if (block_size && vertex_blocks && vertex_components && vertex_combined) {
+      EXPECT_EQ(vertex_combined->low,
+                block_size->low / 4 * vertex_blocks->low +
+                    vertex_components->low);
+      EXPECT_EQ(vertex_combined->medium,
+                block_size->medium / 4 * vertex_blocks->medium +
+                    vertex_components->medium);
+      EXPECT_EQ(vertex_combined->high,
+                block_size->high / 4 * vertex_blocks->high +
+                    vertex_components->high);
+    }
+    if (block_size && fragment_blocks && fragment_components &&
+        fragment_combined) {
+      EXPECT_EQ(fragment_combined->low,
+                block_size->low / 4 * fragment_blocks->low +
+                    fragment_components->low);
+      EXPECT_EQ(fragment_combined->medium,
+                block_size->medium / 4 * fragment_blocks->medium +
+                    fragment_components->medium);
+      EXPECT_EQ(fragment_combined->high,
+                block_size->high / 4 * fragment_blocks->high +
+                    fragment_components->high);
+    }
+    // Varying components cover four floats per varying vector.
+    const WebGLCapabilityRow* varying_components =
+        FindRow(rows, GL_MAX_VARYING_COMPONENTS);
+    const WebGLCapabilityRow* varying_vectors =
+        FindRow(rows, GL_MAX_VARYING_VECTORS);
+    if (varying_components && varying_vectors) {
+      EXPECT_GE(varying_components->low, 4 * varying_vectors->low);
+      EXPECT_GE(varying_components->medium, 4 * varying_vectors->medium);
+      EXPECT_GE(varying_components->high, 4 * varying_vectors->high);
+    }
+    // Draw buffers never exceed color attachments.
+    const WebGLCapabilityRow* draw_buffers =
+        FindRow(rows, GL_MAX_DRAW_BUFFERS);
+    const WebGLCapabilityRow* color_attachments =
+        FindRow(rows, GL_MAX_COLOR_ATTACHMENTS);
+    if (draw_buffers && color_attachments) {
+      EXPECT_LE(draw_buffers->low, color_attachments->low);
+      EXPECT_LE(draw_buffers->medium, color_attachments->medium);
+      EXPECT_LE(draw_buffers->high, color_attachments->high);
+    }
+  }
+  // WebGL1 draw-buffer extension rows keep draw buffers and color
+  // attachments consistent on every tier.
+  const auto extension_rows = AllWebGL1DrawBufferRowsForTesting();
+  ASSERT_FALSE(extension_rows.empty());
+  const WebGLCapabilityRow* extension_draw =
+      FindRow(extension_rows, GL_MAX_DRAW_BUFFERS);
+  const WebGLCapabilityRow* extension_color =
+      FindRow(extension_rows, GL_MAX_COLOR_ATTACHMENTS);
+  ASSERT_TRUE(extension_draw);
+  ASSERT_TRUE(extension_color);
+  EXPECT_LE(extension_draw->low, extension_color->low);
+  EXPECT_LE(extension_draw->medium, extension_color->medium);
+  EXPECT_LE(extension_draw->high, extension_color->high);
+}
+
+}  // namespace helium_noise
+}  // namespace blink
