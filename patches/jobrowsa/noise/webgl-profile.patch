+void WebGLRenderingContextBase::ApplyReadbackNoise(
+    ExecutionContext* execution_context,
+    GLenum format,
+    GLenum type,
+    GLsizei width,
+    GLsizei height,
+    uint8_t* pixels) {
+  using helium_noise::HeliumNoiseProfile;
+  using helium_noise::ProfileDomain;
+  if (!pixels || width <= 0 || height <= 0 || !execution_context) {
+    return;
+  }
+  // Noise only tight unambiguous RGBA rows; anything else stays native.
+  if (format != GL_RGBA) {
+    return;
+  }
+  SkColorType color_type;
+  size_t channels = 4;
+  switch (type) {
+    case GL_UNSIGNED_BYTE:
+      color_type = kRGBA_8888_SkColorType;
+      channels = 1;
+      break;
+    case GL_FLOAT:
+      color_type = kRGBA_F32_SkColorType;
+      channels = sizeof(float);
+      break;
+    case GL_HALF_FLOAT:
+      color_type = kRGBA_F16_SkColorType;
+      channels = sizeof(uint16_t);
+      break;
+    default:
+      // Packed and depth/stencil types are byte-identical (fail open).
+      return;
+  }
+  if (!base::FeatureList::IsEnabled(blink::features::kHeliumNoise) ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoiseWebGL)) {
+    return;
+  }
+  auto* profile = HeliumNoiseProfile::From(execution_context);
+  if (!profile) {
+    return;
+  }
+  const size_t total_bytes = static_cast<size_t>(width) * height * channels *
+                             4;
+  base::span<uint8_t> byte_span(pixels, total_bytes);
+  HeliumNoiseHash hash(
+      HeliumNoiseToken(profile->Hash(ProfileDomain::kRendering)));
+  CanvasNoisingHelper::MaybeNoiseRawPixelBuffer(hash, color_type, byte_span,
+                                                width, height);
+}
+
+void WebGLRenderingContextBase::ApplyReadbackNoiseForTesting(
+    ExecutionContext* execution_context,
+    GLenum format,
+    GLenum type,
+    GLsizei width,
+    GLsizei height,
+    void* pixels) {
+  ApplyReadbackNoise(execution_context, format, type, width, height,
+                     static_cast<uint8_t*>(pixels));
+}
