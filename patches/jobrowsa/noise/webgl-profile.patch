+std::vector<uint8_t> WebGLRenderingContextBase::NativeTransferPixelsForTesting(
+    ExecutionContext* execution_context) {
+  // Deterministic native frame: the same base pixels the transfer helper
+  // reads, but this path never consults the noise boundary.
+  std::vector<uint8_t> pixels(kTestReadbackSize * kTestReadbackSize *
+                              kRgbaChannels);
+  if (execution_context) {
+    scoped_refptr<StaticBitmapImage> image = BaseTestImage(kTestReadbackSize);
+    if (image &&
+        image->PaintImageForCurrentFrame().readPixels(
+            SkImageInfo::Make(kTestReadbackSize, kTestReadbackSize,
+                              kRGBA_8888_SkColorType, kUnpremul_SkAlphaType),
+            pixels.data(), kTestReadbackSize * kRgbaChannels, 0, 0)) {
+      return pixels;
+    }
+  }
+  return pixels;
+}
+
+std::vector<uint8_t>
+WebGLRenderingContextBase::TransferToImageBitmapPixelsForTesting(
+    ExecutionContext* execution_context) {
+  // Reuse the same gate chain and noise algorithm as the real
+  // TransferToImageBitmapBase path: master -> kHeliumNoiseWebGL -> profile,
+  // hashed on the kRendering domain, then MaybeNoiseSnapshotWithHash.
+  std::vector<uint8_t> pixels(kTestReadbackSize * kTestReadbackSize *
+                              kRgbaChannels);
+  if (!execution_context) {
+    return pixels;
+  }
+  scoped_refptr<StaticBitmapImage> image = BaseTestImage(kTestReadbackSize);
+  if (!image) {
+    return pixels;
+  }
+  if (!base::FeatureList::IsEnabled(blink::features::kHeliumNoise) ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoiseWebGL)) {
+    // Gate off: the transfer yields the identical unnoised frame.
+  } else if (auto* profile =
+                 helium_noise::HeliumNoiseProfile::From(execution_context)) {
+    HeliumNoiseHash hash(
+        HeliumNoiseToken(profile->Hash(helium_noise::ProfileDomain::
+                                           kRendering)));
+    CanvasNoisingHelper::MaybeNoiseSnapshotWithHash(execution_context,
+                                                    std::move(hash), image);
+    if (!image) {
+      return pixels;
+    }
+  }
+  if (image &&
+      image->PaintImageForCurrentFrame().readPixels(
+          SkImageInfo::Make(kTestReadbackSize, kTestReadbackSize,
+                            kRGBA_8888_SkColorType, kUnpremul_SkAlphaType),
+          pixels.data(), kTestReadbackSize * kRgbaChannels, 0, 0)) {
+    return pixels;
+  }
+  return pixels;
+}
