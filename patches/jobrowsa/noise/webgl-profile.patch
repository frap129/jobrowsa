+// RED (Task 3): WebGL helium-noise boundary tests. The fixture methods call
+// the testing seams that the GREEN step adds to WebGLRenderingContextBase
+// (mirroring the real production reading paths):
+//
+//   static void ApplyReadbackNoiseForTesting(ExecutionContext*, GLenum format,
+//       GLenum type, GLsizei width, GLsizei height, void* pixels)
+//       - wraps the post-ReadPixels noise boundary and fails open (no noise)
+//       for packed pixel types such as GL_UNSIGNED_SHORT_4_4_4_4;
+//   static String GetUnmaskedVendorForTesting(ExecutionContext*) /
+//   static String GetUnmaskedRendererForTesting(ExecutionContext*)
+//       - read the unmasked WEBGL_debug_renderer_info path exactly like
+//       WebGLRenderingContextBase::GetParameter does (spoof feature branch
+//       first, then the native GL string);
+//   static std::vector<uint8_t> NativeTransferPixelsForTesting(
+//       ExecutionContext*) /
+//   static std::vector<uint8_t> TransferToImageBitmapPixelsForTesting(
+//       ExecutionContext*)
+//       - render a deterministic frame and hand back the non-transfer and
+//       transferToImageBitmap readback, both top-down, so they differ only by
+//       the WebGL-gated noise boundary.
+//
+// None of these seams exist yet, so this file fails to compile in RED.
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/test/scoped_feature_list.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.h"
+#include "third_party/khronos/GLES3/gl3.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+namespace {
+
+class WebGLHeliumNoiseTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  // TearDown order matters: the scoped list must be destroyed while the test's
+  // instance is still alive, before PageTestBase's teardown.
+  void TearDown() override {
+    scoped_feature_list_.reset();
+    PageTestBase::TearDown();
+  }
+
+  void EnableHeliumWebGLWithToken(uint64_t token) {
+    helium_noise_on_ = true;
+    helium_webgl_on_ = true;
+    ApplyFeatureStates();
+    HeliumNoiseTokenMap tokens = GetPage().GetHeliumNoiseTokens();
+    tokens.insert_or_assign(HeliumNoiseFeature::kHighEntropy,
+                            HeliumNoiseToken(token));
+    GetPage().SetHeliumNoiseTokens(tokens);
+  }
+
+  void DisableHeliumCanvas() {
+    helium_canvas_on_ = false;
+    ApplyFeatureStates();
+  }
+
+  void DisableHeliumWebGL() {
+    helium_webgl_on_ = false;
+    ApplyFeatureStates();
+  }
+
+  void EnableSpoofWebGLInfo([[maybe_unused]] const std::string& vendor,
+                            [[maybe_unused]] const std::string& renderer) {
+    // The blank spoof values ride the kSpoofWebGLInfo param defaults " "
+    // (blink/common/features.cc:37-38); arguments kept for call-site fidelity.
+    spoof_on_ = true;
+    ApplyFeatureStates();
+  }
+
+  void ApplyReadbackNoiseForTesting(GLenum format,
+                                    GLenum type,
+                                    GLsizei width,
+                                    GLsizei height,
+                                    std::vector<uint16_t>& destination) {
+    WebGLRenderingContextBase::ApplyReadbackNoiseForTesting(
+        GetDocument().GetExecutionContext(), format, type, width, height,
+        reinterpret_cast<void*>(destination.data()));
+  }
+
+  std::string GetUnmaskedVendor() {
+    return WebGLRenderingContextBase::GetUnmaskedVendorForTesting(
+               GetDocument().GetExecutionContext())
+        .Ascii();
+  }
+
+  std::string GetUnmaskedRenderer() {
+    return WebGLRenderingContextBase::GetUnmaskedRendererForTesting(
+               GetDocument().GetExecutionContext())
+        .Ascii();
+  }
+
+  std::vector<uint8_t> NativeTransferPixels() {
+    return WebGLRenderingContextBase::NativeTransferPixelsForTesting(
+        GetDocument().GetExecutionContext());
+  }
+
+  std::vector<uint8_t> TransferToImageBitmapPixels() {
+    return WebGLRenderingContextBase::TransferToImageBitmapPixelsForTesting(
+        GetDocument().GetExecutionContext());
+  }
+
+  std::vector<uint16_t> FilledUint16Buffer() {
+    std::vector<uint16_t> buffer(4 * 4);
+    for (size_t i = 0; i < buffer.size(); ++i) {
+      buffer[i] = static_cast<uint16_t>(1 + (i * 1091 + 977) % 65535);
+    }
+    return buffer;
+  }
+
+ private:
+  // base::test::ScopedFeatureList supports exactly one Init per instance
+  // (scoped_feature_list.cc:461 DCHECKs !init_called_; re-Init in NDEBUG
+  // silently misbehaves), and destroying a list restores the prior global
+  // state. Feature state changes therefore rebuild the list per mutation.
+  void ApplyFeatureStates() {
+    std::vector<base::test::FeatureRefAndParams> enabled;
+    std::vector<base::test::FeatureRef> disabled;
+    // kHeliumNoise, kHeliumNoiseWebGL, and kHeliumNoiseCanvas are all
+    // ENABLED_BY_DEFAULT (blink/common/features.cc:52-67), so each must be
+    // force-listed on every rebuild: enabled when on, disabled when off —
+    // an empty disabled list can never switch a default-on feature off.
+    // kSpoofWebGLInfo is DISABLED_BY_DEFAULT and is enabled with an EMPTY
+    // param map instead of explicit values: ScopedFeatureList's param string
+    // round-trip TRIMs tokens (field_trial_params SplitString), so " " values
+    // would arrive as ""; with no param entries the key is absent and
+    // FeatureParam::Get() returns the defaults " " (features.cc:37-38), which
+    // is also why blank spoofs beat the automatic strings in production.
+    if (helium_noise_on_) {
+      enabled.emplace_back(blink::features::kHeliumNoise,
+                           base::FieldTrialParams());
+    } else {
+      disabled.push_back(blink::features::kHeliumNoise);
+    }
+    if (helium_webgl_on_) {
+      enabled.emplace_back(blink::features::kHeliumNoiseWebGL,
+                           base::FieldTrialParams());
+    } else {
+      disabled.push_back(blink::features::kHeliumNoiseWebGL);
+    }
+    if (helium_canvas_on_) {
+      enabled.emplace_back(blink::features::kHeliumNoiseCanvas,
+                           base::FieldTrialParams());
+    } else {
+      disabled.push_back(blink::features::kHeliumNoiseCanvas);
+    }
+    if (spoof_on_) {
+      enabled.emplace_back(blink::features::kSpoofWebGLInfo,
+                           base::FieldTrialParams());
+    }
+    scoped_feature_list_.reset();
+    scoped_feature_list_ = std::make_unique<base::test::ScopedFeatureList>();
+    scoped_feature_list_->InitWithFeaturesAndParameters(enabled, disabled);
+  }
+
+  bool helium_noise_on_ = false;
+  bool helium_webgl_on_ = false;
+  bool helium_canvas_on_ = false;
+  bool spoof_on_ = false;
+  std::unique_ptr<base::test::ScopedFeatureList> scoped_feature_list_;
+};
+
+// Packed pixel types cannot carry per-channel noise in place; the readback
+// boundary must fail open and leave the caller's buffer untouched.
+TEST_F(WebGLHeliumNoiseTest, PackedReadPixelsFailsOpen) {
+  EnableHeliumWebGLWithToken(17);
+  auto destination = FilledUint16Buffer();
+  const auto before = destination;
+  ApplyReadbackNoiseForTesting(GL_RGBA, GL_UNSIGNED_SHORT_4_4_4_4, 4, 4,
+                               destination);
+  EXPECT_EQ(before, destination);
+}
+
+// An explicit WEBGL_debug_renderer_info spoof takes precedence over the
+// automatic helium renderer canonicalization, because the spoof flag gains
+// its value from the same getParameter branch.
+TEST_F(WebGLHeliumNoiseTest, SpoofFlagPrecedesAutomaticRenderer) {
+  EnableSpoofWebGLInfo(" ", " ");
+  EnableHeliumWebGLWithToken(17);
+  EXPECT_EQ(" ", GetUnmaskedVendor());
+  EXPECT_EQ(" ", GetUnmaskedRenderer());
+}
+
+// The direct bitmap transfer path consults the WebGL noise gate, not the
+// canvas compatibility gate, so noising the transfer bitmap survives disabling
+// kHeliumNoiseCanvas and dies only with kHeliumNoiseWebGL.
+TEST_F(WebGLHeliumNoiseTest, DirectBitmapTransferUsesWebGLGateNotCanvasGate) {
+  EnableHeliumWebGLWithToken(17);
+  DisableHeliumCanvas();
+  EXPECT_NE(NativeTransferPixels(), TransferToImageBitmapPixels());
+  DisableHeliumWebGL();
+  EXPECT_EQ(NativeTransferPixels(), TransferToImageBitmapPixels());
+}
+
+}  // namespace
+}  // namespace blink
