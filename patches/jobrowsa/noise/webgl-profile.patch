+// Edge length of the synthetic test readback frame.
+constexpr GLsizei kTestReadbackSize = 8;
+constexpr size_t kRgbaChannels = 4;
+
+sk_sp<SkImage> MakeBaseTestSkImage(GLsizei size) {
+  SkImageInfo info = SkImageInfo::Make(size, size, kRGBA_8888_SkColorType,
+                                       kUnpremul_SkAlphaType);
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(info)) {
+    return nullptr;
+  }
+  for (int y = 0; y < size; ++y) {
+    for (int x = 0; x < size; ++x) {
+      uint8_t* pixel = static_cast<uint8_t*>(bitmap.getAddr(x, y));
+      pixel[0] = static_cast<uint8_t>(1 + (x * 31 + y * 17 + 0 * 5) % 255);
+      pixel[1] = static_cast<uint8_t>(1 + (x * 31 + y * 17 + 1 * 5) % 255);
+      pixel[2] = static_cast<uint8_t>(1 + (x * 31 + y * 17 + 2 * 5) % 255);
+      pixel[3] = 255;
+    }
+  }
+  return bitmap.asImage();
+}
+
+scoped_refptr<StaticBitmapImage> BaseTestImage(GLsizei size) {
+  sk_sp<SkImage> image = MakeBaseTestSkImage(size);
+  if (!image) {
+    return nullptr;
+  }
+  return UnacceleratedStaticBitmapImage::Create(std::move(image));
+}
