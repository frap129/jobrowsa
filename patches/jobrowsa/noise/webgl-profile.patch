+namespace blink {
+namespace helium_noise {
+namespace {
+
+constexpr size_t kTierCount = 3;
+
+GLint64 TierValue(const WebGLCapabilityRow& row, size_t tier_index) {
+  switch (tier_index) {
+    case 0:
+      return row.low;
+    case 1:
+      return row.medium;
+    default:
+      return row.high;
+  }
+}
+
+// The locked WebGL 2 capability rows: material limits well below the ceiling
+// of any current desktop-class GPU. The MAX_VIEWPORT_DIMS row governs both
+// viewport axes.
+constexpr std::array<WebGLCapabilityRow, 29> kWebGL2CapabilityRows = {{
+    {GL_MAX_TEXTURE_SIZE, 2048, 8192, 16384},
+    {GL_MAX_CUBE_MAP_TEXTURE_SIZE, 2048, 8192, 16384},
+    {GL_MAX_3D_TEXTURE_SIZE, 256, 1024, 2048},
+    {GL_MAX_ARRAY_TEXTURE_LAYERS, 256, 1024, 2048},
+    {GL_MAX_RENDERBUFFER_SIZE, 2048, 8192, 16384},
+    {GL_MAX_VIEWPORT_DIMS, 2048, 8192, 16384},
+    {GL_MAX_VERTEX_ATTRIBS, 16, 16, 32},
+    {GL_MAX_TEXTURE_IMAGE_UNITS, 16, 16, 32},
+    {GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS, 16, 16, 32},
+    {GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, 32, 32, 64},
+    {GL_MAX_VARYING_VECTORS, 15, 16, 31},
+    {GL_MAX_VERTEX_UNIFORM_VECTORS, 256, 1024, 4096},
+    {GL_MAX_FRAGMENT_UNIFORM_VECTORS, 224, 1024, 4096},
+    {GL_MAX_DRAW_BUFFERS, 4, 8, 8},
+    {GL_MAX_COLOR_ATTACHMENTS, 4, 8, 8},
+    {GL_MAX_SAMPLES, 4, 8, 16},
+    {GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS, 64, 128, 256},
+    {GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_ATTRIBS, 4, 4, 8},
+    {GL_MAX_TRANSFORM_FEEDBACK_SEPARATE_COMPONENTS, 4, 4, 8},
+    {GL_MAX_UNIFORM_BUFFER_BINDINGS, 24, 48, 72},
+    {GL_MAX_UNIFORM_BLOCK_SIZE, 16384, 65536, 131072},
+    {GL_MAX_COMBINED_UNIFORM_BLOCKS, 24, 48, 72},
+    {GL_MAX_VERTEX_UNIFORM_BLOCKS, 12, 24, 36},
+    {GL_MAX_VERTEX_UNIFORM_COMPONENTS, 1024, 4096, 16384},
+    {GL_MAX_FRAGMENT_UNIFORM_BLOCKS, 12, 24, 36},
+    {GL_MAX_FRAGMENT_UNIFORM_COMPONENTS, 896, 4096, 16384},
+    {GL_MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS, 50176, 397312, 1196032},
+    {GL_MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS, 50048, 397312, 1196032},
+    {GL_MAX_VARYING_COMPONENTS, 60, 64, 124},
+}};
+
+// WebGL 1 exposes only the applicable limits, in the locked named-field order
+// (max_texture_size, max_cube_map_texture_size, max_renderbuffer_size,
+// max_viewport_width, max_viewport_height, max_vertex_attribs,
+// max_texture_image_units, max_vertex_texture_image_units,
+// max_combined_texture_image_units, max_varying_vectors,
+// max_vertex_uniform_vectors, max_fragment_uniform_vectors). The single
+// GL_MAX_VIEWPORT_DIMS row covers both viewport axes; zero is legal only for
+// its MAX_VERTEX_TEXTURE_IMAGE_UNITS low row.
+constexpr std::array<WebGLCapabilityRow, 11> kWebGL1CapabilityRows = {{
+    {GL_MAX_TEXTURE_SIZE, 2048, 8192, 16384},
+    {GL_MAX_CUBE_MAP_TEXTURE_SIZE, 2048, 8192, 16384},
+    {GL_MAX_RENDERBUFFER_SIZE, 2048, 8192, 16384},
+    {GL_MAX_VIEWPORT_DIMS, 2048, 8192, 16384},
+    {GL_MAX_VERTEX_ATTRIBS, 8, 16, 16},
+    {GL_MAX_TEXTURE_IMAGE_UNITS, 8, 16, 32},
+    {GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS, 0, 8, 16},
+    {GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, 8, 24, 48},
+    {GL_MAX_VARYING_VECTORS, 8, 15, 31},
+    {GL_MAX_VERTEX_UNIFORM_VECTORS, 128, 256, 1024},
+    {GL_MAX_FRAGMENT_UNIFORM_VECTORS, 16, 224, 1024},
+}};
+
+// WEBGL_draw_buffers extension values for WebGL 1, indexed by the eligible-row
+// selection index: 0 -> {1, 1}, 1 -> {4, 4}, 2 -> {8, 8}. The two columns of
+// each pair are MAX_DRAW_BUFFERS and MAX_COLOR_ATTACHMENTS.
+constexpr std::array<WebGLCapabilityRow, 2> kWebGL1DrawBufferRows = {{
+    {GL_MAX_DRAW_BUFFERS, 1, 4, 8},
+    {GL_MAX_COLOR_ATTACHMENTS, 1, 4, 8},
+}};
+
+// Software renderers are classified before any hardware vendor so a host CPU
+// running llvmpipe never masks as discrete graphics.
+constexpr const char* kSoftwareMarkers[] = {
+    "SwiftShader",
+    "ANGLE SwiftShader",
+    "llvmpipe",
+    "softpipe",
+};
+constexpr const char* kIntelMarkers[] = {"Intel"};
+constexpr const char* kAmdMarkers[] = {"AMD", "ATI", "Radeon"};
+constexpr const char* kNvidiaMarkers[] = {"NVIDIA"};
+
+bool ContainsCaseInsensitive(const char* haystack, const char* needle) {
+  if (!haystack || !needle || !*needle) {
+    return false;
+  }
+  const size_t haystack_length = std::strlen(haystack);
+  for (size_t offset = 0; offset < haystack_length; ++offset) {
+    size_t position = 0;
+    while (needle[position] != '\0') {
+      if (offset + position >= haystack_length) {
+        return false;
+      }
+      if (std::tolower(static_cast<unsigned char>(haystack[offset + position])) !=
+          std::tolower(static_cast<unsigned char>(needle[position]))) {
+        break;
+      }
+      ++position;
+    }
+    if (needle[position] == '\0') {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool MatchesAnyMarker(const char* value, const char* const* markers, size_t count) {
+  if (!value) {
+    return false;
+  }
+  for (size_t index = 0; index < count; ++index) {
+    if (ContainsCaseInsensitive(value, markers[index])) {
+      return true;
+    }
+  }
+  return false;
+}
+
+template <size_t MarkerCount>
+bool MatchesAnyMarker(const char* value, const char* const (&markers)[MarkerCount]) {
+  return MatchesAnyMarker(value, markers, MarkerCount);
+}
+
+// A row tier is eligible when every reported limit stays at or below the
+// corresponding native limit and both viewport axes stay within the native
+// viewport dimensions.
+bool Fits(const base::flat_map<GLenum, GLint64>& native_limits,
+          GLint native_max_viewport_width,
+          GLint native_max_viewport_height,
+          const base::span<const WebGLCapabilityRow> rows,
+          size_t tier_index) {
+  for (const WebGLCapabilityRow& row : rows) {
+    const GLint64 tier_value = TierValue(row, tier_index);
+    const auto native_value = native_limits.find(row.pname);
+    if (native_value != native_limits.end() &&
+        tier_value > native_value->second) {
+      return false;
+    }
+  }
+  const auto viewport_row = std::ranges::find(
+      rows, GL_MAX_VIEWPORT_DIMS, [](const WebGLCapabilityRow& row) {
+        return row.pname;
+      });
+  if (viewport_row == rows.end()) {
+    return true;
+  }
+  const GLint64 tier_viewport = TierValue(*viewport_row, tier_index);
+  const auto native_viewport = native_limits.find(GL_MAX_VIEWPORT_DIMS);
+  if (native_viewport != native_limits.end() &&
+      tier_viewport > native_viewport->second) {
+    return false;
+  }
+  return tier_viewport <= static_cast<GLint64>(native_max_viewport_width) &&
+         tier_viewport <= static_cast<GLint64>(native_max_viewport_height);
+}
+
+WebGLCapabilityView ToCapabilityView(
+    const base::span<const WebGLCapabilityRow> rows,
+    size_t tier_index) {
+  WebGLCapabilityView view;
+  for (const WebGLCapabilityRow& row : rows) {
+    view.limits[row.pname] = TierValue(row, tier_index);
+  }
+  const auto viewport_row = std::ranges::find(
+      rows, GL_MAX_VIEWPORT_DIMS, [](const WebGLCapabilityRow& row) {
+        return row.pname;
+      });
+  if (viewport_row != rows.end()) {
+    const GLint64 tier_viewport = TierValue(*viewport_row, tier_index);
+    view.max_viewport_width = base::checked_cast<GLint>(tier_viewport);
+    view.max_viewport_height = base::checked_cast<GLint>(tier_viewport);
+  }
+  return view;
+}
+
+}  // namespace
+
+base::span<const WebGLCapabilityRow> CapabilityRows(WebGLVersion version) {
+  return version == WebGLVersion::k1
+             ? base::span<const WebGLCapabilityRow>(kWebGL1CapabilityRows)
+             : base::span<const WebGLCapabilityRow>(kWebGL2CapabilityRows);
+}
+
+base::span<const WebGLCapabilityRow> WebGL1DrawBufferRows() {
+  return base::span<const WebGLCapabilityRow>(kWebGL1DrawBufferRows);
+}
+
+std::optional<WebGLCapabilityView> SelectWebGLCapabilityView(
+    uint64_t profile_hash,
+    WebGLVersion version,
+    const base::flat_map<GLenum, GLint64>& native_limits,
+    GLint native_max_viewport_width,
+    GLint native_max_viewport_height) {
+  if (native_max_viewport_width < 0 || native_max_viewport_height < 0) {
+    return std::nullopt;
+  }
+  const base::span<const WebGLCapabilityRow> rows = CapabilityRows(version);
+  // Every required pname must be present exactly once (flat_map keys are
+  // unique, so one sorted pass suffices), non-negative, and non-overflowing.
+  // Zero is legal only for WebGL1 MAX_VERTEX_TEXTURE_IMAGE_UNITS.
+  for (const WebGLCapabilityRow& row : rows) {
+    const auto native_value = native_limits.find(row.pname);
+    if (native_value == native_limits.end()) {
+      return std::nullopt;
+    }
+    if (native_value->second < 0) {
+      return std::nullopt;
+    }
+    const bool zero_allowed = version == WebGLVersion::k1 &&
+                              row.pname == GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS;
+    if (native_value->second == 0 && !zero_allowed) {
+      return std::nullopt;
+    }
+    base::CheckedNumeric<GLint64> checked_value(native_value->second);
+    if (!checked_value.IsValid()) {
+      return std::nullopt;
+    }
+  }
+  // Unknown pnames cannot participate; report them as invalid input instead
+  // of silently ignoring them.
+  for (const auto& [pname, native_value] : native_limits) {
+    const bool known =
+        std::ranges::any_of(rows, [pname](const WebGLCapabilityRow& row) {
+          return row.pname == pname;
+        });
+    if (!known) {
+      return std::nullopt;
+    }
+    (void)native_value;
+  }
+
+  std::array<size_t, kTierCount> eligible_tiers = {};
+  size_t eligible_count = 0;
+  for (size_t tier_index = 0; tier_index < kTierCount; ++tier_index) {
+    if (Fits(native_limits, native_max_viewport_width,
+             native_max_viewport_height, rows, tier_index)) {
+      eligible_tiers[eligible_count++] = tier_index;
+    }
+  }
+  if (eligible_count == 0) {
+    return std::nullopt;
+  }
+  HeliumNoiseHash hash{HeliumNoiseToken(profile_hash)};
+  hash.Update(static_cast<uint64_t>(version));
+  const size_t selected_position =
+      static_cast<size_t>(hash.GetValueBelow(static_cast<int>(eligible_count)));
+  const size_t selected_tier = eligible_tiers[selected_position];
+  WebGLCapabilityView view = ToCapabilityView(rows, selected_tier);
+  if (version == WebGLVersion::k1) {
+    // The extension draw-buffer pair follows the eligible-row index, not the
+    // selected tier index.
+    view.limits[GL_MAX_DRAW_BUFFERS] =
+        TierValue(kWebGL1DrawBufferRows[0], selected_position);
+    view.limits[GL_MAX_COLOR_ATTACHMENTS] =
+        TierValue(kWebGL1DrawBufferRows[1], selected_position);
+  }
+  return view;
+}
+
+RendererClass ClassifyRenderer(const char* vendor, const char* renderer) {
+  if (MatchesAnyMarker(vendor, kSoftwareMarkers) ||
+      MatchesAnyMarker(renderer, kSoftwareMarkers)) {
+    return RendererClass::kSoftware;
+  }
+  if (MatchesAnyMarker(vendor, kIntelMarkers) ||
+      MatchesAnyMarker(renderer, kIntelMarkers)) {
+    return RendererClass::kIntel;
+  }
+  if (MatchesAnyMarker(vendor, kAmdMarkers) ||
+      MatchesAnyMarker(renderer, kAmdMarkers)) {
+    return RendererClass::kAmd;
+  }
+  if (MatchesAnyMarker(vendor, kNvidiaMarkers) ||
+      MatchesAnyMarker(renderer, kNvidiaMarkers)) {
+    return RendererClass::kNvidia;
+  }
+  return RendererClass::kUnknown;
+}
+
+std::optional<CanonicalRendererInfo> SelectCanonicalRendererInfo(
+    uint64_t profile_hash,
+    RendererClass renderer_class) {
+  // Placeholder-but-plausible canonical rows; GREEN locks these strings.
+  static constexpr CanonicalRendererInfo kSoftwareCanonical[] = {
+      {"Google Inc.", "ANGLE (Google, Vulkan 1.3.0 (SwiftShader))"},
+      {"Mesa", "llvmpipe (LLVM 17.0.6, 256 bits)"},
+  };
+  static constexpr CanonicalRendererInfo kIntelCanonical[] = {
+      {"Intel", "Intel(R) UHD Graphics 630"},
+      {"Intel", "Intel(R) Iris(R) Xe Graphics"},
+  };
+  static constexpr CanonicalRendererInfo kAmdCanonical[] = {
+      {"AMD", "AMD Radeon(TM) Graphics"},
+      {"AMD", "AMD Radeon RX 6600"},
+  };
+  static constexpr CanonicalRendererInfo kNvidiaCanonical[] = {
+      {"NVIDIA Corporation", "NVIDIA GeForce GT 1030"},
+      {"NVIDIA Corporation", "NVIDIA GeForce GTX 1650"},
+  };
+  base::span<const CanonicalRendererInfo> canonical;
+  switch (renderer_class) {
+    case RendererClass::kSoftware:
+      canonical = kSoftwareCanonical;
+      break;
+    case RendererClass::kIntel:
+      canonical = kIntelCanonical;
+      break;
+    case RendererClass::kAmd:
+      canonical = kAmdCanonical;
+      break;
+    case RendererClass::kNvidia:
+      canonical = kNvidiaCanonical;
+      break;
+    case RendererClass::kUnknown:
+      return std::nullopt;
+  }
+  HeliumNoiseHash hash{HeliumNoiseToken(profile_hash)};
+  hash.Update(static_cast<uint64_t>(renderer_class));
+  return canonical[hash.GetValueBelow(static_cast<int>(canonical.size()))];
+}
+
+}  // namespace helium_noise
+}  // namespace blink
