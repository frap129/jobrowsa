+void WebGLRenderingContextBase::ApplyHeliumCapabilityView() {
+  // Gate chain: master -> WebGL feature -> profile. Failure leaves everything
+  // native; nothing is re-queried per getParameter.
+  if (!base::FeatureList::IsEnabled(blink::features::kHeliumNoise) ||
+      !base::FeatureList::IsEnabled(blink::features::kHeliumNoiseWebGL)) {
+    return;
+  }
+  auto* profile = helium_noise::HeliumNoiseProfile::From(GetExecutionContext());
+  if (!profile) {
