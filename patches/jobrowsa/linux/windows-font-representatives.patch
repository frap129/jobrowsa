+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
+
+#include <atomic>
+
+#include <unicode/uchar.h>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+namespace helium_noise {
+
+// Process-global rendering allowlist for platform-layer font code, which
+// cannot see the core FontCohortResolver. Populated once by core when the
+// first resolver is created; inert (fail-open) until then. Thread-safe:
+// fallback lookups can run on worker threads concurrently with population.
+//
+// Relies on Chromium's one-browser-profile-per-renderer invariant: all
+// ExecutionContexts in a renderer process derive the same identity, so one
+// snapshot is valid for the process lifetime.
+class PLATFORM_EXPORT FontCohortRuntime {
+ public:
+  static FontCohortRuntime& Instance();
+
+  FontCohortRuntime(const FontCohortRuntime&) = delete;
+  FontCohortRuntime& operator=(const FontCohortRuntime&) = delete;
+
+  bool IsActive() const;
+  // True when the identity's platform enforcement applies right now: the
+  // runtime has been populated and the Windows-identity gate is still on, so
+  // turning the subfeature off falls back to native behavior without a
+  // restart.
+  bool IsEnforcing() const;
+  void Populate(Vector<String> allowed_names);
+  bool Allows(const String& name) const;
+  // Fixed script/block mapping (spec): Hiragana/Katakana/Han -> Noto Sans CJK
+  // JP, emoji -> Noto Color Emoji. Hangul deliberately unmapped (fail-open
+  // rather than wrong JP glyph variants). Returns nullptr when unmapped or
+  // inactive.
+  const char* CanonicalFallbackForCharacter(UChar32 c) const;
+
+ private:
+  friend class base::NoDestructor<FontCohortRuntime>;
+  FontCohortRuntime() = default;
+
+  // Guarded by lock_; read lock-free after the release store of active_.
+  mutable base::Lock lock_;
+  Vector<String> allowed_names_ GUARDED_BY(lock_);
+  std::atomic<bool> active_{false};
+};
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
