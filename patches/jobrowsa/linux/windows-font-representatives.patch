+// Exactly the removable style suffixes; never strip arbitrary words.
+constexpr const char* kStyleSuffixes[] = {
+    "regular", "roman",   "book",  "medium", "bold",
+    "italic",  "oblique", "light", "semibold",
+};
+
+// Comparison probe used to verify that a representative's rendered width
+// differs from the representatives of the other generic classes. The string
+// mixes narrow and wide glyphs, mirroring the classic width-based font
+// detection technique.
+constexpr char kProbeText[] = "mmMwWLliI0fiflO&1";
+constexpr float kProbeSize = 64.0f;
+constexpr float kWidthEpsilon = 0.5f;
+
+struct ClassCandidatePool {
+  FontGenericClass generic_class;
+  base::span<const char* const> families;
+};
+
+// Candidate order is preference order. Windows default families come first so
+// a host that really has them renders the identity natively; the remaining
+// entries are the metric-compatible substitutes and common Linux desktop
+// families used as representatives.
+constexpr const char* kSansCandidates[] = {
+    "Arial",   "Liberation Sans", "Arimo",     "Nimbus Sans", "Helvetica",
+    "Carlito", "DejaVu Sans",     "Noto Sans", "Ubuntu",      "Cantarell",
+    "FreeSans"};
+constexpr const char* kSerifCandidates[] = {
+    "Times New Roman", "Liberation Serif", "Tinos",     "Nimbus Roman",
+    "P052",            "C059",             "Caladea",   "DejaVu Serif",
+    "Noto Serif",      "Georgia",          "URW Bookman", "FreeSerif"};
+constexpr const char* kMonospaceCandidates[] = {
+    "Courier New", "Consolas",     "Liberation Mono", "Cousine",
+    "Nimbus Mono PS", "DejaVu Sans Mono", "Noto Sans Mono", "Noto Mono",
+    "Ubuntu Mono", "FreeMono"};
+constexpr const char* kSymbolCandidates[] = {
+    "Segoe UI Symbol", "Standard Symbols PS", "D050000L",
+    "Noto Sans Symbols 2", "Symbola", "Noto Sans Symbols", "DejaVu Sans"};
+constexpr const char* kDisplayCandidates[] = {
+    "Impact", "Comic Sans MS", "URW Gothic", "Nimbus Sans Narrow",
+    "Liberation Sans Narrow", "Z003", "DejaVu Sans", "DejaVu Serif"};
+
+constexpr ClassCandidatePool kClassCandidatePools[] = {
+    {FontGenericClass::kSans, base::span<const char* const>(kSansCandidates)},
+    {FontGenericClass::kSerif, base::span<const char* const>(kSerifCandidates)},
+    {FontGenericClass::kMonospace,
+     base::span<const char* const>(kMonospaceCandidates)},
+    {FontGenericClass::kSymbol,
+     base::span<const char* const>(kSymbolCandidates)},
+    {FontGenericClass::kDisplay,
+     base::span<const char* const>(kDisplayCandidates)},
+};
+
+bool MatchesInstalledFamily(FontCache* font_cache, const AtomicString& name) {
+  if (name.empty()) {
+    return false;
+  }
+  FontDescription description;
+  // Alternate-name behavior disabled: only a family whose platform name
+  // matches the requested name counts as installed.
+  const SimpleFontData* font_data = font_cache->GetFontData(
+      description, name, AlternateFontName::kNoAlternate);
+  if (!font_data) {
+    return false;
+  }
+  return NormalizePlatformFamily(font_data->PlatformData().FontFamilyName()) ==
+         NormalizePlatformFamily(name);
+}
+
+float MeasureProbeWidth(FontCache* font_cache, const AtomicString& family) {
+  FontDescription description;
+  const SimpleFontData* font_data = font_cache->GetFontData(
+      description, family, AlternateFontName::kNoAlternate);
+  if (!font_data) {
+    return 0.0f;
+  }
+  SkFont sk_font = font_data->PlatformData().CreateSkFont();
+  sk_font.setSize(kProbeSize);
+  return sk_font.measureText(kProbeText, strlen(kProbeText),
+                             SkTextEncoding::kUTF8);
+}
+
+}  // namespace
+
+String NormalizePlatformFamily(const String& name) {
+  String normalized = name.DeprecatedLower();
+  normalized = normalized.Replace('-', ' ');
+  while (normalized.find("  ") != kNotFound) {
+    normalized = normalized.Replace("  ", " ");
+  }
+  for (const char* suffix : kStyleSuffixes) {
+    const String suffix_string(suffix);
+    // Only one trailing suffix removal; require the separator so that
+    // arbitrary trailing words are preserved.
+    if (normalized.DeprecatedEndsWithIgnoringCase(suffix_string) &&
+        normalized.length() > suffix_string.length() + 1) {
+      const unsigned without = normalized.length() - suffix_string.length();
+      if (normalized[without - 1] == ' ') {
+        normalized = normalized.DeprecatedSubstring(0, without - 1);
+        break;
+      }
+    }
+  }
+  return normalized;
+}
+
+FontCohortPlatformData ProbeWindowsFontCohortPlatformLinux(
+    FontCache* font_cache) {
+  FontCohortPlatformData platform_data;
+  if (!font_cache) {
+    return platform_data;
+  }
+  platform_data.class_representatives.resize(kFontGenericClassCount);
+
+  for (const FontIdentity& identity : ApprovedFontIdentities()) {
+    if (MatchesInstalledFamily(font_cache, AtomicString(identity.primary))) {
+      platform_data.installed_identities.push_back(
+          String::FromUtf8(identity.primary));
+    }
+  }
+
+  // Width-probe the candidates class by class and keep the first installed
+  // candidate whose probe width differs from every already-selected
+  // representative. Pairwise-distinct representatives make every fabricated
+  // family register as installed against the other classes' representatives,
+  // which the identity exposes as the detector's base fonts. If a class has
+  // only colliding candidates, the first installed one is kept anyway
+  // (known-imperfect per spec) rather than dropping the class.
+  std::array<float, kFontGenericClassCount> selected_widths{};
+  std::array<bool, kFontGenericClassCount> has_selected_width{};
+  for (const ClassCandidatePool& pool : kClassCandidatePools) {
+    const size_t class_index = static_cast<size_t>(pool.generic_class);
+    bool have_projected = false;
+    AtomicString projected;
+    float projected_width = 0.0f;
+    for (const char* candidate : pool.families) {
+      const AtomicString name(candidate);
+      if (!MatchesInstalledFamily(font_cache, name)) {
+        continue;
+      }
+      const float width = MeasureProbeWidth(font_cache, name);
+      if (!have_projected) {
+        have_projected = true;
+        projected = name;
+        projected_width = width;
+      }
+      bool distinct = true;
+      for (size_t i = 0; i < selected_widths.size(); ++i) {
+        if (has_selected_width[i] &&
+            std::fabs(selected_widths[i] - width) <= kWidthEpsilon) {
+          distinct = false;
+          break;
+        }
+      }
+      if (distinct) {
+        projected = name;
+        projected_width = width;
+        break;
+      }
+    }
+    if (have_projected) {
+      platform_data.class_representatives[class_index] = projected;
+      selected_widths[class_index] = projected_width;
+      has_selected_width[class_index] = true;
+    }
+  }
+  return platform_data;
+}
+
+}  // namespace helium_noise
+}  // namespace blink
