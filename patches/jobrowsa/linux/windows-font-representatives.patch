+
+namespace {
+
+constexpr const char kCjkCanonical[] = "Noto Sans CJK JP";
+constexpr const char kEmojiCanonical[] = "Noto Color Emoji";
+
+}  // namespace
+
+FontCohortRuntime& FontCohortRuntime::Instance() {
+  static base::NoDestructor<FontCohortRuntime> instance;
+  return *instance;
+}
+
+bool FontCohortRuntime::IsActive() const {
+  return active_.load(std::memory_order_acquire);
+}
+
+bool FontCohortRuntime::IsEnforcing() const {
+  return IsActive() && IsWindowsIdentityEnabled();
+}
+
+void FontCohortRuntime::Populate(Vector<String> allowed_names) {
+  if (allowed_names.empty()) {
+    return;
+  }
+  base::AutoLock lock(lock_);
+  if (active_.load(std::memory_order_relaxed)) {
+    return;
+  }
+  allowed_names_ = std::move(allowed_names);
+  active_.store(true, std::memory_order_release);
+}
+
+bool FontCohortRuntime::Allows(const String& name) const {
+  if (!IsActive() || name.empty()) {
+    return false;
+  }
+  base::AutoLock lock(lock_);
+  for (const String& allowed : allowed_names_) {
+    if (EqualIgnoringAsciiCase(allowed, name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const char* FontCohortRuntime::CanonicalFallbackForCharacter(UChar32 c) const {
+  if (!IsActive()) {
+    return nullptr;
+  }
+  if (Character::IsEmoji(c) || Character::IsEmojiIncludingReserved(c)) {
+    return kEmojiCanonical;
+  }
+  UErrorCode err = U_ZERO_ERROR;
+  UScriptCode script = uscript_getScript(c, &err);
+  if (U_SUCCESS(err)) {
+    if (script == USCRIPT_HIRAGANA || script == USCRIPT_KATAKANA ||
+        script == USCRIPT_KATAKANA_OR_HIRAGANA || script == USCRIPT_HAN ||
+        script == USCRIPT_HAN_WITH_BOPOMOFO) {
+      return kCjkCanonical;
+    }
+  }
+  // Compatibility ideographs can report USCRIPT_COMMON.
+  if (script == USCRIPT_COMMON && Character::IsIdeographic(c)) {
+    return kCjkCanonical;
+  }
+  return nullptr;
+}
+
+}  // namespace helium_noise
+}  // namespace blink
