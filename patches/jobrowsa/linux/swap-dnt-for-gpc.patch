+namespace content {
+namespace {
+
+// The GPC header attach path consults the browser client, so install a
+// test client; DataSaver is disabled by the base implementation, which is
+// all the Save-Data branch needs. The browser context is required because
+// the client consults it for worker-script requests.
+class BrowserInitiatedResourceRequestTest : public testing::Test {
+ protected:
+  BrowserInitiatedResourceRequestTest() {
+    old_browser_client_ =
+        SetBrowserClientForTesting(&test_browser_client_);
+  }
+
+  ~BrowserInitiatedResourceRequestTest() override {
+    SetBrowserClientForTesting(old_browser_client_);
+  }
+
+  BrowserTaskEnvironment task_environment_;
+  TestBrowserContext browser_context_;
+  TestContentBrowserClient test_browser_client_;
+
+ private:
+  raw_ptr<ContentBrowserClient> old_browser_client_ = nullptr;
+};
+
+// A browser-initiated document request carries Sec-GPC: 1 and no DNT
+// header with the swapped defaults.
+TEST_F(BrowserInitiatedResourceRequestTest, DocumentHeadersWithDefaults) {
+  blink::RendererPreferences prefs;
+  prefs.enable_do_not_track = false;
+  prefs.enable_global_privacy_control = true;
+
+  net::HttpRequestHeaders headers;
+  UpdateAdditionalHeadersForBrowserInitiatedRequest(
+      &headers, &browser_context_, /*should_update_existing_headers=*/false,
+      prefs,
+      /*is_for_worker_script=*/false);
+
+  EXPECT_EQ("1", headers.GetHeader(blink::kGlobalPrivacyControlHeader));
+  EXPECT_FALSE(headers.HasHeader(blink::kDoNotTrackHeader));
+}
+
+// Worker-script requests receive the same GPC signal with the swapped
+// defaults.
+TEST_F(BrowserInitiatedResourceRequestTest, WorkerScriptHeadersWithDefaults) {
+  blink::RendererPreferences prefs;
+  prefs.enable_do_not_track = false;
+  prefs.enable_global_privacy_control = true;
+
+  net::HttpRequestHeaders headers;
+  UpdateAdditionalHeadersForBrowserInitiatedRequest(
+      &headers, &browser_context_, /*should_update_existing_headers=*/false,
+      prefs,
+      /*is_for_worker_script=*/true);
+
+  EXPECT_EQ("1", headers.GetHeader(blink::kGlobalPrivacyControlHeader));
+  EXPECT_FALSE(headers.HasHeader(blink::kDoNotTrackHeader));
+}
+
+// A user re-enabling DNT still attaches the header; the setting is kept.
+TEST_F(BrowserInitiatedResourceRequestTest, DntHeaderOnOptIn) {
+  blink::RendererPreferences prefs;
+  prefs.enable_do_not_track = true;
+  prefs.enable_global_privacy_control = true;
+
+  net::HttpRequestHeaders headers;
+  UpdateAdditionalHeadersForBrowserInitiatedRequest(
+      &headers, &browser_context_, /*should_update_existing_headers=*/false,
+      prefs,
+      /*is_for_worker_script=*/false);
+
+  EXPECT_EQ("1", headers.GetHeader(blink::kDoNotTrackHeader));
+}
