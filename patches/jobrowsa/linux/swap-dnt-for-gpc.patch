+// The DNT signal ships off by default: its default was flipped from true
+// to false, superseding the vendored Vanadium flip by layering.
+TEST_F(BrowserPrefsTest, DoNotTrackDefaultIsFalse) {
+  EXPECT_FALSE(prefs_.GetBoolean(prefs::kEnableDoNotTrack));
+}
+
+// The GPC signal ships on by default so Sec-GPC: 1 is sent on document,
+// worker, and browser-initiated requests.
+TEST_F(BrowserPrefsTest, GlobalPrivacyControlDefaultIsTrue) {
+  EXPECT_TRUE(prefs_.GetBoolean(prefs::kHeliumGlobalPrivacyControl));
+}
