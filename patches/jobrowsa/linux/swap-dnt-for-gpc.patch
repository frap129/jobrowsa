+// Stands in for LocalFrameClientImpl: it derives both navigator surfaces
+// from RendererPreferences, so the stub values mirror the swapped defaults
+// (DNT pref off, GPC pref on).
+class GpcDntFrameClient : public EmptyLocalFrameClient {
+ public:
+  String DoNotTrackValue() override { return String(); }
+  bool GlobalPrivacyControlEnabled() override { return true; }
+};
+
+class NavigatorGpcDntTest : public PageTestBase {
+ protected:
+  NavigatorGpcDntTest() {
+    client_ = MakeGarbageCollected<GpcDntFrameClient>();
+    PageTestBase::SetupPageWithClients(nullptr, client_);
+  }
+
+  Navigator& GetNavigator() {
+    return *GetDocument().domWindow()->navigator();
+  }
+
+  Persistent<GpcDntFrameClient> client_;
+};
+
+// With the DNT preference off, navigator.doNotTrack is null: the empty
+// String() from DoNotTrackValue() serializes as the nullable attribute's
+// null value.
+TEST_F(NavigatorGpcDntTest, DoNotTrackIsNullWhenPreferenceOff) {
+  EXPECT_TRUE(NavigatorDoNotTrack::doNotTrack(GetNavigator()).IsNull());
+}
+
+// With the GPC preference on, navigator.globalPrivacyControl reports true.
+TEST_F(NavigatorGpcDntTest, GlobalPrivacyControlIsTrueWhenPreferenceOn) {
+  EXPECT_TRUE(NavigatorGlobalPrivacyControl::globalPrivacyControl(
+      GetNavigator()));
+}
