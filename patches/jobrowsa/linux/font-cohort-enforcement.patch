+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
+
+#include <atomic>
+
+#include <unicode/uchar.h>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "third_party/blink/renderer/platform/platform_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+namespace helium_noise {
+
+// Process-global cohort state for platform-layer font code, which cannot see
+// the core FontCohortResolver. Populated once by core when the first resolver
+// is created; inert (fail-open) until then. Thread-safe: fallback lookups can
+// run on worker threads concurrently with population.
+//
+// Relies on Chromium's one-browser-profile-per-renderer invariant: all
+// ExecutionContexts in a renderer process derive the same cohort, so one
+// snapshot is valid for the process lifetime.
+class PLATFORM_EXPORT FontCohortRuntime {
+ public:
+  static FontCohortRuntime& Instance();
+
+  FontCohortRuntime(const FontCohortRuntime&) = delete;
+  FontCohortRuntime& operator=(const FontCohortRuntime&) = delete;
+
+  bool IsActive() const;
+  void Populate(Vector<String> allowed_names);
+  bool Allows(const String& name) const;
+  // Fixed script/block mapping (spec): Hiragana/Katakana/Han -> Noto Sans CJK
+  // JP, emoji -> Noto Color Emoji. Hangul deliberately unmapped (fail-open
+  // rather than wrong JP glyph variants). Returns nullptr when unmapped or
+  // inactive.
+  const char* CanonicalFallbackForCharacter(UChar32 c) const;
+
+ private:
+  friend class base::NoDestructor<FontCohortRuntime>;
+  FontCohortRuntime() = default;
+
+  // Guarded by lock_; read lock-free after the release store of active_.
+  mutable base::Lock lock_;
+  Vector<String> allowed_names_ GUARDED_BY(lock_);
+  std::atomic<bool> active_{false};
+};
+
+}  // namespace helium_noise
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_FONT_COHORT_RUNTIME_H_
Index: src/third_party/blink/renderer/platform/fonts/font_cohort_runtime.cc
--- /dev/null
+++ src/third_party/blink/renderer/platform/fonts/font_cohort_runtime.cc
@@ -0,0 +1,100 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/fonts/font_cohort_runtime.h"
+
+#include <unicode/uchar.h>
+#include <unicode/uscript.h>
+
+#include "third_party/blink/renderer/platform/text/character.h"
+
+namespace blink {
+namespace helium_noise {
+
+namespace {
+
+constexpr const char kCjkCanonical[] = "Noto Sans CJK JP";
+constexpr const char kEmojiCanonical[] = "Noto Color Emoji";
+
+bool EqualIgnoringAsciiCase(const String& a, const String& b) {
+  if (a.length() != b.length()) {
+    return false;
+  }
+  for (wtf_size_t i = 0; i < a.length(); ++i) {
+    UChar ca = a[i];
+    UChar cb = b[i];
+    if (ca >= 'A' && ca <= 'Z') {
+      ca += 'a' - 'A';
+    }
+    if (cb >= 'A' && cb <= 'Z') {
+      cb += 'a' - 'A';
+    }
+    if (ca != cb) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+FontCohortRuntime& FontCohortRuntime::Instance() {
+  static base::NoDestructor<FontCohortRuntime> instance;
+  return *instance;
+}
+
+bool FontCohortRuntime::IsActive() const {
+  return active_.load(std::memory_order_acquire);
+}
+
+void FontCohortRuntime::Populate(Vector<String> allowed_names) {
+  if (allowed_names.empty()) {
+    return;
+  }
+  base::AutoLock lock(lock_);
+  if (active_.load(std::memory_order_relaxed)) {
+    return;
+  }
+  allowed_names_ = std::move(allowed_names);
+  active_.store(true, std::memory_order_release);
+}
+
+bool FontCohortRuntime::Allows(const String& name) const {
+  if (!IsActive() || name.empty()) {
+    return false;
+  }
+  base::AutoLock lock(lock_);
+  for (const String& allowed : allowed_names_) {
+    if (EqualIgnoringAsciiCase(allowed, name)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+const char* FontCohortRuntime::CanonicalFallbackForCharacter(UChar32 c) const {
+  if (!IsActive()) {
+    return nullptr;
+  }
+  if (Character::IsEmoji(c) || Character::IsEmojiIncludingReserved(c)) {
+    return kEmojiCanonical;
+  }
+  UErrorCode err = U_ZERO_ERROR;
+  UScriptCode script = uscript_getScript(c, &err);
+  if (U_SUCCESS(err)) {
+    if (script == USCRIPT_HIRAGANA || script == USCRIPT_KATAKANA ||
+        script == USCRIPT_KATAKANA_OR_HIRAGANA || script == USCRIPT_HAN ||
+        script == USCRIPT_HAN_WITH_BOPOMOFO) {
+      return kCjkCanonical;
+    }
+  }
+  // Compatibility ideographs can report USCRIPT_COMMON.
+  if (script == USCRIPT_COMMON && Character::IsIdeographic(c)) {
+    return kCjkCanonical;
+  }
+  return nullptr;
+}
+
+}  // namespace helium_noise
+}  // namespace blink
