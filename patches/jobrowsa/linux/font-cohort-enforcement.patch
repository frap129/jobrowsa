+AtomicString ResolveToPrimary(const FontCohortResolver& resolver,
+                              const AtomicString& name) {
+  if (name.empty()) {
+    return AtomicString();
+  }
+  for (const uint8_t index : resolver.selected_) {
+    const FontIdentity& identity = ApprovedFontIdentities()[index];
+    if (EqualIgnoringAsciiCase(identity.primary, name)) {
+      return AtomicString(identity.primary);
+    }
+    for (const char* alias : identity.aliases) {
+      if (alias[0] != '\0' && EqualIgnoringAsciiCase(alias, name)) {
+        return AtomicString(identity.primary);
+      }
+    }
+  }
+  return AtomicString();
+}
