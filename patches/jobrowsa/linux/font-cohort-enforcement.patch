+void PopulateFontCohortRuntime(const FontCohortResolver& resolver) {
+  Vector<String> allowed_names;
+  for (const uint8_t index : resolver.selected_) {
+    const FontIdentity& identity = ApprovedFontIdentities()[index];
+    allowed_names.push_back(String::FromUtf8(identity.primary));
+    for (const char* alias : identity.aliases) {
+      if (alias[0] != '\0') {
+        allowed_names.push_back(String::FromUtf8(alias));
+      }
+    }
+  }
+  FontCohortRuntime::Instance().Populate(std::move(allowed_names));
+}
