+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/events/navigator_events.h"
+
+#include <array>
+#include <cstdint>
+#include <utility>
+
+#include "base/test/scoped_feature_list.h"
+#include "build/build_config.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/frame/navigator.h"
+#include "third_party/blink/renderer/core/frame/settings.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+
+namespace blink {
+
+class NavigatorEventsTest : public PageTestBase {
+ protected:
+  Navigator& GetNavigator() {
+    return *GetDocument().domWindow()->navigator();
+  }
+};
+
+TEST_F(NavigatorEventsTest, NormalizesOnlyPositiveTouchCounts) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitWithFeatures({features::kHeliumNoise}, {});
+  for (const auto& [native_value, linux_expected] :
+       std::to_array<std::pair<int32_t, int32_t>>(
+           {{0, 0}, {1, 5}, {5, 5}, {10, 5}})) {
+    GetDocument().GetSettings()->SetMaxTouchPoints(native_value);
+#if BUILDFLAG(IS_LINUX)
+    EXPECT_EQ(linux_expected,
+              NavigatorEvents::maxTouchPoints(GetNavigator()));
+#else
+    EXPECT_EQ(native_value,
+              NavigatorEvents::maxTouchPoints(GetNavigator()));
+#endif
+  }
+}
+
+TEST_F(NavigatorEventsTest, DisabledMasterReturnsNativeValue) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitAndDisableFeature(features::kHeliumNoise);
+  GetDocument().GetSettings()->SetMaxTouchPoints(10);
+  EXPECT_EQ(10, NavigatorEvents::maxTouchPoints(GetNavigator()));
+}
+
+TEST_F(NavigatorEventsTest, NullWindowReturnsZero) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitWithFeatures({features::kHeliumNoise}, {});
+  Navigator* navigator = MakeGarbageCollected<Navigator>(nullptr);
+  EXPECT_EQ(0, NavigatorEvents::maxTouchPoints(*navigator));
+}
+
+TEST_F(NavigatorEventsTest, IgnoresLegacyTouchAndPrimaryPointerSettings) {
+  base::test::ScopedFeatureList scoped_feature_list;
+  scoped_feature_list.InitWithFeatures({features::kHeliumNoise}, {});
+  Settings* settings = GetDocument().GetSettings();
+  settings->SetMaxTouchPoints(1);
+  settings->SetPrimaryPointerType(mojom::PointerType::kPointerFineType);
+  settings->SetForceTouchEventFeatureDetectionForInspector(false);
+#if BUILDFLAG(IS_LINUX)
+  EXPECT_EQ(5, NavigatorEvents::maxTouchPoints(GetNavigator()));
+#else
+  EXPECT_EQ(1, NavigatorEvents::maxTouchPoints(GetNavigator()));
+#endif
+}
+
+}  // namespace blink
