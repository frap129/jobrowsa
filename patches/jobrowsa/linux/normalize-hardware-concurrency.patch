+// found in the LICENSE file.
+
+#include <cstdint>
+#include <memory>
+#include <set>
+#include <vector>
+
+#include "base/test/scoped_feature_list.h"
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
+#include "third_party/blink/public/common/features.h"
+#include "third_party/blink/public/common/helium_noise/noise_token.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/testing/page_test_base.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace blink {
+
+unsigned MaybeNormalizeHardwareConcurrency(ExecutionContext*, unsigned);
+
+namespace {
+
+class NavigatorBaseTest : public PageTestBase {
+ public:
+  void SetUp() override { PageTestBase::SetUp(gfx::Size()); }
+
+  void EnableNoiseFeatures() {
+    InitFeatures({features::kHeliumNoise, features::kHeliumNoiseCpuCores}, {});
+  }
+
+  void DisableMasterFeature() { InitFeatures({}, {features::kHeliumNoise}); }
+
+  void EnableMasterDisableCpuFeature() {
+    InitFeatures({features::kHeliumNoise}, {features::kHeliumNoiseCpuCores});
+  }
+
+  void SetProfileMemory(unsigned logical_processors, int64_t memory_mb) {
+    ApproximatedDeviceMemory::SetPhysicalMemoryMBForTesting(
+        memory_mb, logical_processors);
+  }
+
+  void SetHardwareToken(uint64_t token) {
+    Context()->SetHeliumNoiseTokens(
+        {{HeliumNoiseFeature::kHardware, HeliumNoiseToken(token)}});
+  }
+
+  ExecutionContext* Context() {
+    ExecutionContext* context = GetDocument().GetExecutionContext();
+    EXPECT_TRUE(context);
+    return context;
+  }
+
+ private:
+  // A live ScopedFeatureList must never be reinitialized, so every feature
+  // state gets its own instance that stays alive for the test.
+  void InitFeatures(std::initializer_list<base::test::FeatureRef> enabled,
+                    std::initializer_list<base::test::FeatureRef> disabled) {
+    auto scoped_feature_list =
+        std::make_unique<base::test::ScopedFeatureList>();
+    scoped_feature_list->InitWithFeatures(enabled, disabled);
+    feature_lists_.push_back(std::move(scoped_feature_list));
+  }
+
+  std::vector<std::unique_ptr<base::test::ScopedFeatureList>> feature_lists_;
+};
+
+TEST_F(NavigatorBaseTest, MissingContextOrHardwareTokenFailsOpen) {
+  EnableNoiseFeatures();
+  SetProfileMemory(8, 8192);
+  EXPECT_EQ(8u, MaybeNormalizeHardwareConcurrency(nullptr, 8));
+  EXPECT_EQ(8u, MaybeNormalizeHardwareConcurrency(Context(), 8));
+}
+
+TEST_F(NavigatorBaseTest, DisabledFeaturesFailOpen) {
+  SetProfileMemory(8, 8192);
+  SetHardwareToken(1);
+  DisableMasterFeature();
+  EXPECT_EQ(8u, MaybeNormalizeHardwareConcurrency(Context(), 8));
+  EnableMasterDisableCpuFeature();
+  EXPECT_EQ(8u, MaybeNormalizeHardwareConcurrency(Context(), 8));
+}
+
+TEST_F(NavigatorBaseTest, TokenSelectionIsDeterministicAndCapabilitySafe) {
+  EnableNoiseFeatures();
+  SetProfileMemory(8, 8192);
+  SetHardwareToken(7);
+  const unsigned first = MaybeNormalizeHardwareConcurrency(Context(), 8);
+  EXPECT_EQ(first, MaybeNormalizeHardwareConcurrency(Context(), 8));
+  EXPECT_THAT(first, testing::AnyOf(4u, 8u));
+  EXPECT_EQ(4u, MaybeNormalizeHardwareConcurrency(Context(), 6));
+}
+
+TEST_F(NavigatorBaseTest, EligibleTokensCanSelectDifferentCandidates) {
+  EnableNoiseFeatures();
+  SetProfileMemory(8, 8192);
+  std::set<unsigned> values;
+  for (uint64_t token = 0; token < 256; ++token) {
+    SetHardwareToken(token);
+    values.insert(MaybeNormalizeHardwareConcurrency(Context(), 8));
+  }
+  EXPECT_THAT(values, testing::UnorderedElementsAre(4u, 8u));
+}
+
+TEST_F(NavigatorBaseTest, UnsupportedProfileFailsOpen) {
+  EnableNoiseFeatures();
+  SetProfileMemory(1, 16384);
+  SetHardwareToken(1);
+  EXPECT_EQ(1u, MaybeNormalizeHardwareConcurrency(Context(), 1));
+}
+
+}  // namespace
+}  // namespace blink
