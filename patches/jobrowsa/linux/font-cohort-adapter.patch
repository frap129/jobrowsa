+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+// -----------------------------------------------------------------------
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/linux/font_cohort_linux.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace helium_noise {
+
+TEST(FontCohortLinuxTest, NormalizesOnlyKnownStyleSuffixes) {
+  EXPECT_EQ("liberation sans",
+            NormalizePlatformFamily("Liberation Sans Bold"));
+  EXPECT_EQ("dejavu sans mono", NormalizePlatformFamily("DejaVu-Sans-Mono"));
+  EXPECT_EQ("fingerprint test font",
+            NormalizePlatformFamily("Fingerprint Test Font"));
+  // A trailing word that is not a known style suffix must survive.
+  EXPECT_EQ("fingerprint test font ultra",
+            NormalizePlatformFamily("Fingerprint Test Font Ultra"));
+  // Multiple style suffixes: only one is removed.
+  EXPECT_EQ("noto serif italic",
+            NormalizePlatformFamily("Noto Serif Italic Bold"));
+}
+
+TEST(FontCohortLinuxTest, NormalizationIsComparisonOnlyPreservingCase) {
+  // Normalization only affects comparison; declared names are exact matches
+  // against a normalized platform name from PlatformData.
+  EXPECT_EQ(NormalizePlatformFamily("Liberation-Sans Regular"),
+            NormalizePlatformFamily("liberation sans"));
+}
+
+}  // namespace helium_noise
+}  // namespace blink
