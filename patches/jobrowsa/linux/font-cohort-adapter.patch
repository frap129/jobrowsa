+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_LINUX_FONT_COHORT_LINUX_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HELIUM_NOISE_LINUX_FONT_COHORT_LINUX_H_
+
+#include <cstdint>
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+namespace blink {
+
+class FontCache;
+
+namespace helium_noise {
+
+// Linux availability adapter: probes only the approved table rows through
+// FontCache and returns the sorted unique indices of the identities whose
+// primary or declared alias name resolves to a real installed family.
+CORE_EXPORT Vector<uint8_t> ProbeAvailableFontIdentitiesLinux(FontCache* font_cache);
+
+// Comparison-only normalization: lowercase, collapse spaces/hyphens, and
+// remove at most one trailing known style suffix.
+CORE_EXPORT String NormalizePlatformFamily(const String& name);
+
+}  // namespace helium_noise
+}  // namespace blink
