+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/helium_noise/linux/font_cohort_linux.h"
+
+#include <array>
+
+#include "build/build_config.h"
+#include "third_party/blink/renderer/core/helium_noise/font_cohort.h"
+#include "third_party/blink/renderer/platform/fonts/font_cache.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "third_party/blink/renderer/platform/fonts/simple_font_data.h"
+
+namespace blink {
+namespace helium_noise {
+
+namespace {
+
+// Exactly the removable style suffixes; never strip arbitrary words.
+constexpr const char* kStyleSuffixes[] = {
+    "regular", "roman",   "book",  "medium", "bold",
+    "italic",  "oblique", "light", "semibold",
+};
+
+bool IsFamilyLastResortFor(const String& platform_name,
+                           const String& requested) {
+  return false;
+}
+
+bool MatchesInstalledFamily(FontCache* font_cache,
+                            const FontIdentity& identity,
+                            const char* declared_name) {
+  if (!declared_name || declared_name[0] == '\0') {
+    return false;
+  }
+  FontDescription description;
+  // Alternate-name behavior disabled: aliases beyond the declared table
+  // names must not count.
+  const SimpleFontData* font_data = font_cache->GetFontData(
+      description, AtomicString(declared_name),
+      AlternateFontName::kNoAlternate);
+  if (!font_data) {
+    return false;
+  }
+  const String platform_name = font_data->PlatformData().FontFamilyName();
+  if (NormalizePlatformFamily(platform_name) ==
+      NormalizePlatformFamily(String(declared_name))) {
+    return true;
+  }
+  return false;
+}
+
+}  // namespace
+
+String NormalizePlatformFamily(const String& name) {
+  String normalized = name.DeprecatedLower();
+  normalized = normalized.Replace('-', ' ');
+  while (normalized.find("  ") != kNotFound) {
+    normalized = normalized.Replace("  ", " ");
+  }
+  for (const char* suffix : kStyleSuffixes) {
+    const String suffix_string(suffix);
+    // Only one trailing suffix removal; require the separator so that
+    // arbitrary trailing words are preserved.
+    if (normalized.DeprecatedEndsWithIgnoringCase(suffix_string) &&
+        normalized.length() > suffix_string.length() + 1) {
+      const unsigned without = normalized.length() - suffix_string.length();
+      if (normalized[without - 1] == ' ') {
+        normalized = normalized.DeprecatedSubstring(0, without - 1);
+        break;
+      }
+    }
+  }
+  return normalized;
+}
+
+Vector<uint8_t> ProbeAvailableFontIdentitiesLinux(FontCache* font_cache) {
+  Vector<uint8_t> available;
+  if (!font_cache) {
+    return available;
+  }
+  const auto identities = ApprovedFontIdentities();
+  for (uint8_t index = 0; index < identities.size(); ++index) {
+    const FontIdentity& identity = identities[index];
+    bool matched = MatchesInstalledFamily(font_cache, identity,
+                                          identity.primary);
+    if (!available.Contains(index) && !identity.aliases[0][0]) {
+      // aliases empty
+    }
+    for (const char* alias : identity.aliases) {
+      if (alias[0] != '\0' && !available.Contains(index)) {
+        if (MatchesInstalledFamily(font_cache, identity, alias)) {
+          available.push_back(index);
+          break;
+        }
+      }
+    }
+    if (!available.Contains(index)) {
+      if (MatchesInstalledFamily(font_cache, identity, identity.primary)) {
+        available.push_back(index);
+      }
+    }
+  }
+  return available;
+}
+
+}  // namespace helium_noise
+}  // namespace blink
