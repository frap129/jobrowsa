+TEST_F(TimeZoneControllerTest, LegacyAliasesMapToCanonicalRepresentatives) {
+  EnableMasterNoise();
+  EXPECT_EQ(NormalizeId("America/New_York"), NormalizeId("US/Eastern"));
+  EXPECT_EQ(NormalizeId("America/New_York"), NormalizeId("Canada/Eastern"));
+  EXPECT_EQ(NormalizeId("Asia/Kolkata"), NormalizeId("Asia/Calcutta"));
+  EXPECT_EQ(NormalizeId("Europe/Kyiv"), NormalizeId("Europe/Kiev"));
+}
