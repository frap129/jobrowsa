+TEST_F(TimeZoneControllerTest, ChangeTimeZoneForTestingAppliesNormalization) {
+  EnableMasterNoise();
+  TimeZoneController::ChangeTimeZoneForTesting("America/Toronto");
+  EXPECT_EQ("America/New_York", CurrentIcuZoneId());
+  EXPECT_EQ("America/New_York", SingletonStoredHostZoneId());
+}
+
+TEST_F(TimeZoneControllerTest, OverrideLifecycleStaysExactAndRestoresNormalizedHost) {
+  EnableMasterNoise();
+  TimeZoneController::ChangeTimeZoneForTesting("Europe/Paris");
+
+  TimeZoneController::TimeZoneOverrideResult result =
+      TimeZoneController::SetTimeZoneOverride("Asia/Tokyo");
+  ASSERT_EQ(TimeZoneController::TimeZoneOverrideStatus::kSuccess,
+            result.status);
+  ASSERT_TRUE(result.handle);
+  EXPECT_EQ("Asia/Tokyo", CurrentIcuZoneId());
+
+  // A host timezone change is normalized and stored, but the exact override
+  // keeps suppressing host application.
+  TimeZoneController::ChangeTimeZoneForTesting("Europe/Andorra");
+  EXPECT_EQ("Asia/Tokyo", CurrentIcuZoneId());
+  EXPECT_EQ("Europe/Paris", SingletonStoredHostZoneId());
+
+  result.handle->change("Asia/Seoul");
+  EXPECT_EQ("Asia/Seoul", CurrentIcuZoneId());
+
+  result.handle.reset();
+  EXPECT_EQ("Europe/Paris", CurrentIcuZoneId());
+  EXPECT_EQ("Europe/Paris", SingletonStoredHostZoneId());
+}
