+// Fixed deterministic validation window: [2026-08-24T00:00:00Z,
+// 2076-08-24T00:00:00Z].
+constexpr int64_t kStartMs = 1787529600000;
+constexpr int64_t kEndMs = 3365452800000;
+
+const char* TZDataVersion() {
+  UErrorCode status = U_ZERO_ERROR;
+  return icu::TimeZone::getTZDataVersion(status);
+}
+
+std::string CurrentIcuZoneId() {
+  std::unique_ptr<icu::TimeZone> zone(icu::TimeZone::createDefault());
+  icu::UnicodeString unicode_id;
+  zone->getID(unicode_id);
+  std::string utf8;
+  unicode_id.toUTF8String(utf8);
+  return utf8;
+}
+
+std::unique_ptr<icu::BasicTimeZone> CreateBasicZone(const char* zone_id) {
+  std::unique_ptr<icu::TimeZone> zone(icu::TimeZone::createTimeZone(
+      icu::UnicodeString(zone_id, -1, US_INV)));
+  if (!zone || *zone == icu::TimeZone::getUnknown()) {
+    return nullptr;
+  }
+  // Every ICU zone returned for a recognized id derives from
+  // BasicTimeZone; Blink core compiles without C++ RTTI.
+  return std::unique_ptr<icu::BasicTimeZone>(
+      static_cast<icu::BasicTimeZone*>(zone.release()));
+}
