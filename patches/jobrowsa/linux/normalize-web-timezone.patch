+std::optional<icu::UnicodeString> CanonicalSystemId(const String& id) {
+  UErrorCode status = U_ZERO_ERROR;
+  UBool is_system_id = false;
+  icu::UnicodeString canonical;
+  icu::TimeZone::getCanonicalID(
+      icu::UnicodeString(id.Ascii().data(), -1, US_INV), canonical,
+      is_system_id, status);
+  if (U_FAILURE(status) || !is_system_id) {
+    return std::nullopt;
+  }
+  return canonical;
+}
+
+bool IsExcludedFixedId(const String& native_id,
+                       const icu::UnicodeString& canonical_id) {
+  const String canonical(unicode::ToSpan(canonical_id));
+  return native_id == "UTC" || native_id == "GMT" ||
+         canonical == "Etc/UTC" || canonical == "Etc/GMT" ||
+         canonical_id.startsWith(icu::UnicodeString("Etc/GMT", -1, US_INV));
+}
