+TEST_F(TimeZoneControllerTest, CohortTableMapsEverySourceToItsRepresentative) {
+  EnableMasterNoise();
+  for (const auto& [source_id, representative_id] : kExpectedCohorts) {
+    SCOPED_TRACE(testing::Message()
+                 << source_id.data() << " -> " << representative_id.data()
+                 << " tzdata " << TZDataVersion());
+    EXPECT_EQ(NormalizeId(representative_id.data()),
+              NormalizeId(source_id.data()));
+  }
+}
+
+TEST_F(TimeZoneControllerTest, CohortMembersShareOffsetsAtFixedStart) {
+  for (const auto& [source_id, representative_id] : kExpectedCohorts) {
+    SCOPED_TRACE(testing::Message()
+                 << source_id.data() << " -> " << representative_id.data()
+                 << " tzdata " << TZDataVersion());
+    std::unique_ptr<icu::BasicTimeZone> source =
+        CreateBasicZone(source_id.data());
+    std::unique_ptr<icu::BasicTimeZone> representative =
+        CreateBasicZone(representative_id.data());
+    ASSERT_TRUE(source);
+    ASSERT_TRUE(representative);
+    ExpectEqualOffsetsAt(*source, *representative, kStartMs, source_id,
+                         representative_id);
+  }
+}
