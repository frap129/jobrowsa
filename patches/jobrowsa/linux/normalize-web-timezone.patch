+TEST_F(TimeZoneControllerTest, CohortMembersHaveEquivalentTransitionsOver50Years) {
+  for (const auto& [source_id, representative_id] : kExpectedCohorts) {
+    SCOPED_TRACE(testing::Message()
+                 << source_id.data() << " -> " << representative_id.data()
+                 << " tzdata " << TZDataVersion());
+    std::unique_ptr<icu::BasicTimeZone> source =
+        CreateBasicZone(source_id.data());
+    std::unique_ptr<icu::BasicTimeZone> representative =
+        CreateBasicZone(representative_id.data());
+    ASSERT_TRUE(source);
+    ASSERT_TRUE(representative);
+    UErrorCode status = U_ZERO_ERROR;
+    const UBool equivalent = source->hasEquivalentTransitions(
+        *representative, kStartMs, kEndMs, /*ignoreDstAmount=*/false, status);
+    EXPECT_TRUE(equivalent);
+    EXPECT_TRUE(U_SUCCESS(status));
+  }
+}
+
+TEST_F(TimeZoneControllerTest, CohortMembersMatchTransitionBoundaries) {
+  for (const auto& [source_id, representative_id] : kExpectedCohorts) {
+    SCOPED_TRACE(testing::Message()
+                 << source_id.data() << " -> " << representative_id.data()
+                 << " tzdata " << TZDataVersion());
+    std::unique_ptr<icu::BasicTimeZone> source =
+        CreateBasicZone(source_id.data());
+    std::unique_ptr<icu::BasicTimeZone> representative =
+        CreateBasicZone(representative_id.data());
+    ASSERT_TRUE(source);
+    ASSERT_TRUE(representative);
+    UDate cursor = kStartMs;
+    for (int transitions_seen = 0; transitions_seen < 500;
+         ++transitions_seen) {
+      icu::TimeZoneTransition source_transition;
+      icu::TimeZoneTransition representative_transition;
+      const UBool source_has = source->getNextTransition(
+          cursor, /*inclusive=*/false, source_transition);
+      const UBool representative_has = representative->getNextTransition(
+          cursor, /*inclusive=*/false, representative_transition);
+      ASSERT_EQ(source_has != 0, representative_has != 0);
+      if (!source_has) {
+        break;
+      }
+      ASSERT_EQ(source_transition.getTime(),
+                representative_transition.getTime());
+      ExpectEqualOffsetsAt(*source, *representative,
+                           source_transition.getTime() - 1.0, source_id,
+                           representative_id);
+      ExpectEqualOffsetsAt(*source, *representative,
+                           source_transition.getTime(), source_id,
+                           representative_id);
+      cursor = source_transition.getTime();
+    }
+  }
+}
