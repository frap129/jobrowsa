+// static
+String TimeZoneController::NormalizeHostTimezoneId(
+    const String& native_id,
+    base::Time validation_start,
+    base::Time validation_end) {
+#if BUILDFLAG(IS_LINUX)
+  if (!base::FeatureList::IsEnabled(features::kHeliumNoise)) {
+    return native_id;
+  }
+
+  const std::optional<icu::UnicodeString> canonical_source =
+      CanonicalSystemId(native_id);
+  if (!canonical_source || IsExcludedFixedId(native_id, *canonical_source)) {
+    return native_id;
+  }
+
+  std::string source_utf8;
+  canonical_source->toUTF8String(source_utf8);
+  const auto cohort = std::find_if(
+      kCohortTable.begin(), kCohortTable.end(),
+      [&source_utf8](const auto& entry) { return entry.first == source_utf8; });
+  if (cohort == kCohortTable.end()) {
+    return native_id;
+  }
+
+  const String representative_id(cohort->second.data());
+  const std::optional<icu::UnicodeString> canonical_representative =
+      CanonicalSystemId(representative_id);
+  if (!canonical_representative) {
+    return native_id;
+  }
+
+  std::unique_ptr<icu::TimeZone> source_zone(
+      icu::TimeZone::createTimeZone(*canonical_source));
+  std::unique_ptr<icu::TimeZone> representative_zone(
+      icu::TimeZone::createTimeZone(*canonical_representative));
+  if (!source_zone || !representative_zone ||
+      *source_zone == icu::TimeZone::getUnknown() ||
+      *representative_zone == icu::TimeZone::getUnknown()) {
+    return native_id;
+  }
+  // Blink core compiles without C++ RTTI; ICU only returns BasicTimeZone
+  // subclasses for recognized system ids, and unknown zones are rejected
+  // above.
+  const auto* source_basic =
+      static_cast<const icu::BasicTimeZone*>(source_zone.get());
+  const auto* representative_basic =
+      static_cast<const icu::BasicTimeZone*>(representative_zone.get());
+
+  const UDate start_ms = validation_start.InMillisecondsFSinceUnixEpoch();
+  const UDate end_ms = validation_end.InMillisecondsFSinceUnixEpoch();
+
+  int32_t source_raw_offset = 0;
+  int32_t source_dst_offset = 0;
+  int32_t representative_raw_offset = 0;
+  int32_t representative_dst_offset = 0;
+  UErrorCode status = U_ZERO_ERROR;
+  source_basic->getOffset(start_ms, /*local=*/false, source_raw_offset,
+                          source_dst_offset, status);
+  if (U_FAILURE(status)) {
+    return native_id;
+  }
+  status = U_ZERO_ERROR;
+  representative_basic->getOffset(start_ms, /*local=*/false,
+                                  representative_raw_offset,
+                                  representative_dst_offset, status);
+  if (U_FAILURE(status) || source_raw_offset != representative_raw_offset ||
+      source_dst_offset != representative_dst_offset) {
+    return native_id;
+  }
+
+  status = U_ZERO_ERROR;
+  const UBool equivalent = source_basic->hasEquivalentTransitions(
+      *representative_basic, start_ms, end_ms, /*ignoreDstAmount=*/false,
+      status);
+  if (!equivalent || U_FAILURE(status)) {
+    return native_id;
+  }
+
+  return representative_id;
+#else
+  return native_id;
+#endif
+}
