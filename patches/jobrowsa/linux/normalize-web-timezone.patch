+// The fixture must live directly in namespace blink so that
+// TimeZoneController's friend declaration names this class.
+class TimeZoneControllerTest : public testing::Test {
+ public:
+  // Friendship does not extend into TEST_F subclasses, so all access to
+  // TimeZoneController internals goes through these members.
+  void EnableMasterNoise() {
+    InitFeaturesFromCommandLine("HeliumNoise");
+  }
+
+  void InitFeaturesFromCommandLine(
+      std::string_view enable_features,
+      std::string_view disable_features = std::string_view()) {
+    feature_lists_.push_back(std::make_unique<base::test::ScopedFeatureList>());
+    feature_lists_.back()->InitFromCommandLine(enable_features,
+                                               disable_features);
+  }
+
+  static String NormalizeId(const char* native_id) {
+    return TimeZoneController::NormalizeHostTimezoneId(
+        String(native_id),
+        base::Time::FromMillisecondsSinceUnixEpoch(kStartMs),
+        base::Time::FromMillisecondsSinceUnixEpoch(kEndMs));
+  }
+
+  static std::unique_ptr<TimeZoneController> MakeController() {
+    return base::WrapUnique(new TimeZoneController());
+  }
+
+  static std::string StoredHostZoneId(TimeZoneController& controller) {
+    base::AutoLock locker(controller.lock_);
+    return controller.host_timezone_id_.Ascii();
+  }
+
+  static bool StoredHostZoneIdIsNull(TimeZoneController& controller) {
+    base::AutoLock locker(controller.lock_);
+    return controller.host_timezone_id_.IsNull();
+  }
+
+  static std::string SingletonStoredHostZoneId() {
+    return StoredHostZoneId(TimeZoneController::instance());
+  }
+
+ private:
+  void SetUp() override {
+    restore_timezone_ =
+        std::make_unique<base::test::ScopedRestoreDefaultTimezone>(
+            "America/Los_Angeles");
+  }
+  void TearDown() override { restore_timezone_.reset(); }
+
+  std::vector<std::unique_ptr<base::test::ScopedFeatureList>> feature_lists_;
+  std::unique_ptr<base::test::ScopedRestoreDefaultTimezone> restore_timezone_;
+};
