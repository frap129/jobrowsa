+namespace {
+
+void ExpectEqualOffsetsAt(const icu::BasicTimeZone& source,
+                          const icu::BasicTimeZone& representative,
+                          double when_ms,
+                          std::string_view source_id,
+                          std::string_view representative_id) {
+  int32_t source_raw_offset = 0;
+  int32_t source_dst_offset = 0;
+  int32_t representative_raw_offset = 0;
+  int32_t representative_dst_offset = 0;
+  UErrorCode source_status = U_ZERO_ERROR;
+  UErrorCode representative_status = U_ZERO_ERROR;
+  source.getOffset(when_ms, /*local=*/false, source_raw_offset,
+                   source_dst_offset, source_status);
+  representative.getOffset(when_ms, /*local=*/false, representative_raw_offset,
+                           representative_dst_offset, representative_status);
+  EXPECT_TRUE(U_SUCCESS(source_status));
+  EXPECT_TRUE(U_SUCCESS(representative_status));
+  EXPECT_EQ(source_raw_offset, representative_raw_offset)
+      << source_id << " vs " << representative_id << " at " << when_ms
+      << " tzdata " << TZDataVersion();
+  EXPECT_EQ(source_dst_offset, representative_dst_offset)
+      << source_id << " vs " << representative_id << " at " << when_ms
+      << " tzdata " << TZDataVersion();
+  EXPECT_EQ(source_raw_offset + source_dst_offset,
+            representative_raw_offset + representative_dst_offset)
+      << source_id << " vs " << representative_id << " at " << when_ms
+      << " tzdata " << TZDataVersion();
+}
