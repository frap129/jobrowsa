+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/device_memory/hardware_profile.h"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <tuple>
+#include <utility>
+#include <vector>
+
+#include "testing/gmock/include/gmock/gmock.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace blink {
+namespace {
+
+using testing::ElementsAre;
+
+TEST(HardwareProfileTest, SelectsHighestCapabilitySafeMemoryTier) {
+  constexpr std::array cases{
+      std::tuple{2u, 2048, std::optional<int>(2)},
+      std::tuple{2u, 8192, std::optional<int>(4)},
+      std::tuple{4u, 16384, std::optional<int>(8)},
+      std::tuple{8u, 8192, std::optional<int>(8)},
+      std::tuple{8u, 16384, std::optional<int>(16)},
+      std::tuple{64u, 131072, std::optional<int>(16)},
+      std::tuple{1u, 16384, std::optional<int>{}},
+      std::tuple{8u, 2047, std::optional<int>{}},
+      std::tuple{3u, 4095, std::optional<int>(2)},
+      std::tuple{6u, 12288, std::optional<int>(8)},
+  };
+  for (const auto& [cores, memory_mb, expected] : cases) {
+    EXPECT_EQ(expected, SelectDeviceMemoryProfile(cores, memory_mb))
+        << "cores=" << cores << ", memory_mb=" << memory_mb;
+  }
+}
+
+TEST(HardwareProfileTest, ReturnsStableCompatibleCoreCandidates) {
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(2, 2), ElementsAre(2));
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(2, 4), ElementsAre(2));
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(4, 4), ElementsAre(2, 4));
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(4, 8), ElementsAre(4));
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(8, 8), ElementsAre(4, 8));
+  EXPECT_THAT(GetHardwareConcurrencyCandidates(8, 16), ElementsAre(8));
+  EXPECT_TRUE(GetHardwareConcurrencyCandidates(1, 2).empty());
+  EXPECT_TRUE(GetHardwareConcurrencyCandidates(8, 32).empty());
+  EXPECT_TRUE(GetHardwareConcurrencyCandidates(0, 8).empty());
+}
+
+TEST(HardwareProfileTest, EveryReturnedPairIsApprovedAndCapabilitySafe) {
+  constexpr std::array approved{
+      std::pair{2u, 2}, std::pair{2u, 4}, std::pair{4u, 4},
+      std::pair{4u, 8}, std::pair{8u, 8}, std::pair{8u, 16},
+  };
+  for (unsigned actual_cores = 1; actual_cores <= 32; ++actual_cores) {
+    for (int64_t memory_mb = 1024; memory_mb <= 32768; memory_mb += 1024) {
+      const std::optional<int> memory =
+          SelectDeviceMemoryProfile(actual_cores, memory_mb);
+      if (!memory)
+        continue;
+      EXPECT_LE(static_cast<int64_t>(*memory) * 1024, memory_mb);
+      for (unsigned core :
+           GetHardwareConcurrencyCandidates(actual_cores, *memory)) {
+        EXPECT_LE(core, actual_cores);
+        EXPECT_NE(std::ranges::find(approved, std::pair{core, *memory}),
+                  approved.end());
+      }
+    }
+  }
+}
+
+}  // namespace
+}  // namespace blink
