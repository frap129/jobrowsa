+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/device_memory/hardware_profile.h"
+
+#include <array>
+
+namespace blink {
+namespace {
+
+struct HardwareProfile {
+  unsigned logical_processors;
+  int device_memory_gb;
+};
+
+constexpr std::array kHardwareProfiles{
+    HardwareProfile{2, 2},
+    HardwareProfile{2, 4},
+    HardwareProfile{4, 4},
+    HardwareProfile{4, 8},
+    HardwareProfile{8, 8},
+    HardwareProfile{8, 16},
+};
+
+}  // namespace
+
+std::optional<int> SelectDeviceMemoryProfile(unsigned logical_processors,
+                                              int64_t physical_memory_mb) {
+  std::optional<int> selected_memory;
+  for (const HardwareProfile& profile : kHardwareProfiles) {
+    if (profile.logical_processors <= logical_processors &&
+        static_cast<int64_t>(profile.device_memory_gb) * 1024 <=
+            physical_memory_mb) {
+      selected_memory = profile.device_memory_gb;
+    }
+  }
+  return selected_memory;
+}
+
+std::vector<unsigned> GetHardwareConcurrencyCandidates(
+    unsigned logical_processors,
+    int device_memory_gb) {
+  std::vector<unsigned> candidates;
+  for (const HardwareProfile& profile : kHardwareProfiles) {
+    if (profile.device_memory_gb == device_memory_gb &&
+        profile.logical_processors <= logical_processors &&
+        (candidates.empty() ||
+         candidates.back() != profile.logical_processors)) {
+      candidates.push_back(profile.logical_processors);
+    }
+  }
+  return candidates;
+}
+
+}  // namespace blink
