is_official_build=true
symbol_level=1
disable_fieldtrial_testing_config=true
blink_enable_generated_code_formatting=false
blink_symbol_level=0
ffmpeg_branding="Chrome"
proprietary_codecs=true
fatal_linker_warnings=false
rtc_use_pipewire=true
rtc_link_pipewire=true
is_clang=true
is_debug=false
use_kerberos=true
use_sysroot=true
use_vaapi=true
use_system_libffi=false
use_siso=true
# sccache rejects compiles carrying clang module flags (-Xclang
# -fmodules-cache-path, -Xclang -fmodule-file-home-is-cwd) and silently
# falls back to uncached compilation, so modules must stay off
use_clang_modules=false
# SIMD baseline (x86-64); args declared by patches/jobrowsa/linux/simd-baseline-avx.patch
use_sse3 = true
use_sse41 = true
use_sse42 = true
use_avx = true
# WebRTC AVX2 support (upstream default for clang builds; explicit for clarity)
rtc_enable_avx2 = true
# Aggressive ThinLTO: deferred optimization pass (default on for official builds)
thin_lto_enable_optimizations = true
# Split text into hot/cold sections for better code locality
use_text_section_splitting = true
# 256-bit long-vector re-vectorization pass in the WASM compilation pipeline
v8_enable_wasm_simd256_revec = true
# Zero-initialize stack variables (hardening; default on for official builds)
init_stack_vars_zero = true
