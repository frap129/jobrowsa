pkgname=jobrowsa-bin
pkgver=${JOBROWSA_VERSION:?JOBROWSA_VERSION must be set}
pkgrel=1
pkgdesc='Private, fast, and honest web browser'
arch=('x86_64' 'aarch64')
url=''
license=('GPL-3.0-only')
depends=(
    'alsa-lib'
    'at-spi2-core'
    'cairo'
    'cups'
    'dbus'
    'expat'
    'glib2'
    'glibc'
    'libdrm'
    'libx11'
    'libxcb'
    'libxcomposite'
    'libxdamage'
    'libxext'
    'libxfixes'
    'libxkbcommon'
    'libxrandr'
    'mesa'
    'nspr'
    'nss'
    'pango'
    'systemd-libs'
)
optdepends=(
    'gtk3: GTK interface support'
    'libva: hardware video acceleration'
    'pipewire: WebRTC screen sharing'
    'qt5-base: Qt 5 interface support'
    'qt6-base: Qt 6 interface support'
    'ttf-liberation: compatible Arial, Times New Roman, and Courier New fonts'
    'vulkan-icd-loader: Vulkan support'
    'xdg-utils: desktop integration'
)
provides=('jobrowsa' 'www-browser')
conflicts=('jobrowsa')
options=('!debug')
backup=('etc/apparmor.d/jobrowsa-bin')

package() {
    local build_output=${JOBROWSA_BUILD_OUTPUT:?JOBROWSA_BUILD_OUTPUT must be set}
    local package_files=${JOBROWSA_PACKAGE_FILES:?JOBROWSA_PACKAGE_FILES must be set}
    local files=(
        jobrowsa
        chrome_100_percent.pak
        chrome_200_percent.pak
        jobrowsa_crashpad_handler
        chromedriver
        icudtl.dat
        libEGL.so
        libGLESv2.so
        libqt5_shim.so
        libqt6_shim.so
        libvulkan.so.1
        locales
        product_logo_256.png
        resources.pak
        v8_context_snapshot.bin
    )

    install -dm755 "$pkgdir/usr/lib/jobrowsa"
    cp -a "${files[@]/#/$build_output/}" "$pkgdir/usr/lib/jobrowsa/"
    install -Dm755 "$package_files/jobrowsa-wrapper.sh" \
        "$pkgdir/usr/lib/jobrowsa/jobrowsa-wrapper"
    sed -Ei 's/(CHROME_VERSION_EXTRA=).*/\1"Arch Linux"/' \
        "$pkgdir/usr/lib/jobrowsa/jobrowsa-wrapper"
    ln -s jobrowsa "$pkgdir/usr/lib/jobrowsa/chrome"

    install -Dm644 "$package_files/jobrowsa.desktop" \
        "$pkgdir/usr/share/applications/jobrowsa.desktop"
    install -Dm644 "$pkgdir/usr/lib/jobrowsa/product_logo_256.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/jobrowsa.png"
    install -Dm644 "$package_files/apparmor.cfg" \
        "$pkgdir/etc/apparmor.d/jobrowsa-bin"
    sed -Ei 's|profile jobrowsa-bin .* flags=|profile jobrowsa-bin "/usr/lib/jobrowsa/jobrowsa" flags=|' \
        "$pkgdir/etc/apparmor.d/jobrowsa-bin"
    install -dm755 "$pkgdir/usr/bin"
    ln -s /usr/lib/jobrowsa/jobrowsa-wrapper "$pkgdir/usr/bin/jobrowsa"
}
